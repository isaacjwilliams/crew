#!/usr/bin/env bash
# Stub Codex CLI for tests: `login status` and `exec`, the way crew calls them.
# State in $HOME:
#   $HOME/codex-calls.log    every call's arguments, and the directory it ran in
#   $HOME/codex-stdin.last   what the latest `exec` read on stdin (its prompt)
#   $HOME/codex-signed-out   if present, `login status` fails, like a signed-out Codex
#   $HOME/codex-fail         if present, `exec` exits 3 after writing its events
# `exec` prints a thread.started event (a new thread, or the one it resumes) and
# writes "stub review" to its -o file. It records LEAK CLAUDECODE if crew left that
# variable set.
set -u
echo "codex $* (in $PWD)" >>"$HOME/codex-calls.log"
[[ -n ${CLAUDECODE:-} ]] && echo "LEAK CLAUDECODE" >>"$HOME/codex-calls.log"

case "${1:-} ${2:-}" in
  "login status")
    if [[ -e $HOME/codex-signed-out ]]; then echo "Not logged in" >&2; exit 1; fi
    echo "Logged in using ChatGPT"
    exit 0
    ;;
esac
[[ ${1:-} == exec ]] || { echo "stub codex: unexpected call: $*" >&2; exit 2; }
shift

thread=0199a3b2-1c2d-7e3f-8a9b-0c1d2e3f4a5b out="" resume=0
while (($#)); do
  case $1 in
    -c | -m | -C) shift 2 ;;
    -o) out=$2; shift 2 ;;
    resume) resume=1; shift ;;
    -) shift ;;
    -*) shift ;;
    *) ((resume)) && thread=$1; shift ;;
  esac
done
cat >"$HOME/codex-stdin.last"
echo "{\"type\":\"thread.started\",\"thread_id\":\"$thread\"}"
echo '{"type":"turn.started"}'
[[ -n $out ]] && echo "stub review" >"$out"
if [[ -e $HOME/codex-fail ]]; then exit 3; fi
echo '{"type":"turn.completed"}'
