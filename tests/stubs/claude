#!/usr/bin/env bash
# Stub `claude` for tests. Never talks to a model. State lives in $HOME:
#   $HOME/claude-calls.log   every invocation
#   $HOME/agents.json        what `claude agents --json` returns; --bg adds or updates a job
#   $HOME/fail-resume        if present, `--resume … --bg` fails
#   $HOME/fail-resume-late   if present, `--resume … --bg` starts a job that ends `failed`
#   $HOME/fail-agent         if present, `-p --agent <the agent it names>` fails
#   $HOME/placeholder-session  if present, the next `claude agents` after a resume shows
#                            the resumed job under a new session ID, as a process does
#                            before it has loaded the session
#   $HOME/stop-noop          if present, `claude stop` leaves the process open
#   $HOME/agents-fail        if present, `claude agents` fails
#   $HOME/agents-next        if present, the next `claude agents` lists agents.json and then
#                            makes this file agents.json: a change between two looks
#   $HOME/rm-fail            if present, `claude rm` fails and keeps the job
#   $HOME/claude-settings.last  the --settings value of the latest call that had one
#   $HOME/claude.cwd            the directory the latest call ran in
#   $HOME/claude-env.log        every invocation again, after the CREW_PROJECT it ran with ("unset" for none)
#   $HOME/claude-fingerprint.log  every invocation again, after its CREW_LEAD_FINGERPRINT ("unset" for none)
#   $HOME/judge-finds        what a judge (`-p --tools ""`, as crew review-eval runs it) finds:
#                            it answers found when its prompt has this text, else missed
#   $HOME/reviewer-writes    if present, the next `-p --agent reviewer` adds a line to the file
#                            it names, then removes it: a change made while a review runs
#   $HOME/claude-interrupt   if present, a bare `claude` sends the signal it names (INT or HUP)
#                            to its process group, as Ctrl+C or a closed terminal does, and
#                            exits as that signal would
# It records LEAK CLAUDECODE if crew left that variable set, and LEAK LOCK FD <n> if
# fd n is open on one of crew's .crew*.lock files.
# Like the real CLI, `--resume <session> --bg <prompt>` continues that session under
# its own job ID. It starts a copy under a new session instead, and says so in a
# `note:` line, if any other launch flag is passed (--agent, --settings, …) or the
# session's process is still open (pid set). A job's ID is the first 8 characters of
# its session ID. Job IDs are printed in color.
# A process that continues a session in place takes its prompt a moment after it
# shows. In the real CLI (2.1.328, after `claude stop`), `claude agents` lists the old
# entry (done, pid null) for about 3 seconds, then the new process (working, pid set,
# no status); its transcript still ends with the last turn's turn_duration for another
# half second or so, before the prompt is written and the turn is under way. crew waits
# through the first part, so the stub models only the second: for two `claude agents`
# listings the job shows working with no status, its transcript as it was, and then
# the process takes its prompt: status busy, and a user entry ends its transcript. A
# session with no transcript reads busy from the start. The two listings are counted
# across every caller, so a new `claude agents` call on a resume path moves the moment
# a second command sees. The resume itself writes a metadata entry to the transcript
# straight away, as 2.1.328 does, so only the prompt shows the turn has started.
set -u
echo "claude $*" >>"$HOME/claude-calls.log"
echo "${CREW_PROJECT-unset} claude $*" >>"$HOME/claude-env.log"
echo "${CREW_LEAD_FINGERPRINT-unset} claude $*" >>"$HOME/claude-fingerprint.log"
echo "$PWD" >"$HOME/claude.cwd"
[[ -n ${CLAUDECODE:-} ]] && echo "LEAK CLAUDECODE" >>"$HOME/claude-calls.log"
# A background supervisor that inherited one of crew's locks would hold it forever.
for fd in /proc/$$/fd/*; do
  [[ $(readlink "$fd" 2>/dev/null) == */.crew*.lock ]] && echo "LEAK LOCK FD ${fd##*/}" >>"$HOME/claude-calls.log"
done
[[ -f $HOME/agents.json ]] || echo '[]' >"$HOME/agents.json"
# The whole process group gets the signal, crew included, as it does from a terminal.
if [[ $# == 0 && -f $HOME/claude-interrupt ]]; then
  sig=$(<"$HOME/claude-interrupt")
  trap 'exit $((128 + $(kill -l "$sig")))' "$sig"
  kill -"$sig" 0
fi

# --add-dir and --mcp-config are variadic in the real CLI: the token after their value must be a flag.
args=("$@") resume="" name="" flags=0
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ (${args[i]} == --add-dir || ${args[i]} == --mcp-config) && ${args[i+2]:-} != --* ]]; then
    echo "stub claude: '${args[i+2]:-}' would be swallowed by ${args[i]}" >&2; exit 9
  fi
  [[ ${args[i]} == --settings ]] && printf '%s' "${args[i+1]:-}" >"$HOME/claude-settings.last"
  [[ ${args[i]} == --resume ]] && resume=${args[i+1]:-}
  [[ ${args[i]} == --name ]] && name=${args[i+1]:-}
  [[ ${args[i]} == --* && ${args[i]} != --resume && ${args[i]} != --bg ]] && flags=1
done

agents() {  # jq-filter [jq args...]: update agents.json in place
  local f=$1; shift
  jq "$@" "$f" "$HOME/agents.json" >"$HOME/agents.json.tmp" && mv "$HOME/agents.json.tmp" "$HOME/agents.json"
}
transcript_of() { compgen -G "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/*/$1.jsonl" | head -n 1; }
# A process that hasn't taken its prompt yet ($HOME/resume-starting: job, session, and
# the listings left that show it so). At each listing it has one fewer, and once it
# has none, it takes its prompt.
starting() {
  [[ -f $HOME/resume-starting ]] || return 0
  local id session left f
  read -r id session left <"$HOME/resume-starting"
  if ((left > 0)); then echo "$id $session $((left - 1))" >"$HOME/resume-starting"; return 0; fi
  rm "$HOME/resume-starting"
  agents 'map(if .id==$id then .status="busy" else . end)' --arg id "$id"
  f=$(transcript_of "$session")
  [[ -z $f ]] || echo '{"type":"user","message":{"role":"user","content":"New input"}}' >>"$f"
}

case ${1:-} in
  --version) echo "2.1.296 (Claude Code)" ;;
  agents)
    if [[ -f $HOME/agents-fail ]]; then
      echo "Error: couldn't reach the supervisor" >&2; exit 1
    fi
    starting
    if [[ -f $HOME/placeholder-pending ]]; then
      jq --arg id "$(cat "$HOME/placeholder-pending")" 'map(if .id==$id then .sessionId="0badf00d-placeholder" else . end)' "$HOME/agents.json"
      rm -f "$HOME/placeholder-pending"
    else
      cat "$HOME/agents.json"
      if [[ -f $HOME/agents-next ]]; then mv "$HOME/agents-next" "$HOME/agents.json"; fi
    fi ;;
  stop)
    [[ -f $HOME/stop-noop ]] || agents 'map(if .id==$id then .pid=null | .state="stopped" | del(.status) else . end)' --arg id "${2:-}" ;;
  rm)
    if [[ -f $HOME/rm-fail ]]; then echo "Error: couldn't delete ${2:-}" >&2; exit 1; fi
    agents 'map(select(.id != $id))' --arg id "${2:-}" ;;
  attach|logs|remote-control) : ;;
  *)
    if [[ " $* " == *" --bg "* ]]; then
      if [[ -f $HOME/fail-resume && -n $resume ]]; then echo "Error: session not found"; exit 1; fi
      session=""
      if [[ -n $resume ]]; then
        if ((flags)); then
          echo "note: background session $resume keeps its own saved options, so the flags you passed started a copy"
        elif [[ -f $HOME/reopen-on-resume ]] || jq -e --arg s "$resume" 'any(.[]; .sessionId==$s and .pid != null)' "$HOME/agents.json" >/dev/null; then
          rm -f "$HOME/reopen-on-resume"
          echo "note: session $resume is already running in the background, so this started a copy"
        else
          session=$resume
        fi
      fi
      if [[ -z $session ]]; then
        id=$(printf '%08x' $((RANDOM * RANDOM + RANDOM)))
        session=$id-stub
      else
        id=${session:0:8}
      fi
      state=working pid=4242 status=busy
      if [[ -f $HOME/fail-resume-late && -n $resume ]]; then state=failed pid=null; fi
      if [[ $session == "$resume" && $state == working && -n $(transcript_of "$session") ]]; then
        status=""; echo "$id $session 2" >"$HOME/resume-starting"
        echo '{"type":"file-history-snapshot"}' >>"$(transcript_of "$session")"
      fi
      agents 'def status: if $stat == "" then del(.status) else .status=$stat end;
              if any(.[]; .id==$id) then map(if .id==$id then .state=$st | .pid=$pid | status else . end)
              else . + [{id:$id, kind:"background", state:$st, pid:$pid, sessionId:$s, name:$name, cwd:$cwd} | status] end' \
        --arg id "$id" --arg s "$session" --arg st "$state" --argjson pid "$pid" --arg stat "$status" --arg cwd "$PWD" --arg name "${name:-untitled session}"
      if [[ -f $HOME/placeholder-session && $session == "$resume" ]]; then echo "$id" >"$HOME/placeholder-pending"; fi
      printf 'backgrounded · \e[36m%s\e[39m · stub\n' "$id"
    elif [[ -f $HOME/fail-agent && " $* " == *" --agent $(cat "$HOME/fail-agent") "* ]]; then
      echo "stub claude -p failed"; exit 1
    elif [[ " $* " == *" --agent reviewer "* ]]; then
      if [[ -f $HOME/reviewer-writes ]]; then
        echo "changed while a review ran" >>"$(cat "$HOME/reviewer-writes")"; rm "$HOME/reviewer-writes"
      fi
      printf '#### 1. [should fix] A stub finding — `a.go:1`\n'
    elif [[ " $* " == *" --tools "* ]]; then
      if [[ -f $HOME/judge-finds && ${args[-1]} == *"$(cat "$HOME/judge-finds")"* ]]; then
        printf 'found\n#### 1. [should fix] A stub finding — `a.go:1`\n'
      else
        printf 'missed\nnone\n'
      fi
    else
      echo "stub claude -p ok"
    fi ;;
esac
