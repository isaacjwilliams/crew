{
  "permissions": {
    "allow": [
      "Bash(crew *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push)",
      "Bash(git pull --ff-only)",
      "Bash(git fetch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr edit *)",
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Agent(lead)",
      "Agent(implementer)",
      "Agent(gardener)",
      "Agent(goal-lead)",
      "Agent(plan-reviewer)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CREW_HOME:-$HOME/crew}/bin/crew-guard\" worker"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CREW_HOME:-$HOME/crew}/bin/crew\" commit --hook"
          }
        ]
      }
    ]
  }
}
