# crew's settings and their defaults. Don't edit this file: it comes from
# upstream. Put your own values in config/crew.env, which is read after it (start
# from templates/crew.env), and per-project ones in projects/<project>/project.env,
# which is read after both. crew reads these files without running them: each
# line is KEY=value, where the value may use quotes, $VAR and ${VAR}, and a
# trailing # comment.

# Maximum number of workers running or waiting on you at once, across all
# projects. Match this to your review capacity, not to the tower's CPU.
MAX_WORKERS=3

# How many of a goal's tasks may be dispatched but unmerged at once (working,
# waiting on you, or sitting in an open PR), for a goal that doesn't set its own
# max_in_flight. Each task of a stack counts. This keeps a goal from opening a
# dozen PRs down a path you'd have stopped after the first few.
GOAL_MAX_IN_FLIGHT=3

# Prefix for branches workers create. These branches are pushed to the shared
# remote, so pick something your collaborators will recognise, e.g. "isaac/".
BRANCH_PREFIX="agent/"

# Where worker worktrees live: $WORK_ROOT/<project>/<task-id>.
# Run `claude` once in this directory and accept the trust dialog (see SETUP.md).
WORK_ROOT="$HOME/agent-work"

# Permission mode for worker sessions: auto | acceptEdits | default.
# `auto` lets a classifier approve routine commands, so workers rarely stop to
# ask. With `default`, workers will sit in "Needs input" in agent view until you
# approve each new command.
WORKER_PERMISSION_MODE="auto"

# How full a worker's conversation gets before Claude Code compacts it: a token
# count from 100k to 1M, or "auto" for Claude Code's default (about 967k on a 1M
# model). Each review round resumes the same conversation, so without a lower
# window it carries every earlier round. That makes each step slower and costlier,
# and leaves stale diffs around. Workers reread their task file after a compaction,
# so nothing that matters is lost. Applies to workers started after you change it.
WORKER_AUTOCOMPACT_WINDOW="400k"

# Permission mode for the lead session started by the `lead` command, and
# for goal leads: auto | acceptEdits | default. With `auto` you aren't asked to
# approve routine commands; crew-guard still keeps their file edits to the ledger.
LEAD_PERMISSION_MODE="auto"

# Defaults written into new task files (each task can override them).
PRE_PR_REVIEW="yes"      # yes | no  — casual-observer pass before opening the PR
PR_MODE="draft"          # draft | ready | none

# Whether workers reply to your review comments ("Done in abc123"): in the thread
# for an inline comment, or as a PR comment quoting a conversation comment or review.
REPLY_TO_THREADS="yes"

# After this many review rounds, `crew followup` warns that the task may need
# a rethink rather than another round.
MAX_REVIEW_ROUNDS=4

# After opening its PR, a worker reviews it with an independent reviewer, fixes
# what the review finds, and reviews again, up to this many times. Then it posts
# one comment on the PR saying what automated review found and fixed. 0 turns
# automated review off.
AUTO_REVIEWS=3

# Codex in automated review: with "yes", each review also runs Codex, read-only,
# alongside the Claude reviewer, and the two answer each other's findings. Needs
# Codex installed and signed in (`codex login`); `crew doctor` checks it. Set it
# in config/crew.env to turn it on for every project. yes | no
CODEX_REVIEW="no"

# The model Codex reviews with, and its reasoning effort (Codex's
# model_reasoning_effort). Change them here when OpenAI ships a newer model.
CODEX_MODEL="gpt-6-astra"
CODEX_MODEL_EFFORT="xhigh"

# Rounds between the two reviewers in each review, when Codex runs: in each, both
# see the findings the other raised and its objections to their own, and confirm,
# refute, withdraw or change the severity of each. 0, 1 or 2. Round 1 is the
# first time each reviewer sees the other's findings, so a refutation made in
# round 1 can only be answered in round 2: with 1, it stands unanswered.
AUTO_REVIEW_REBUTTALS=2

# Gitignored files copied from the main checkout into each new worktree
# (space-separated, relative to the repo root), e.g. ".env .env.local".
WORKTREE_COPY=""

# How task worktrees are created and removed: "git" (plain `git worktree`) or
# "worktrunk" (`wt switch` / `wt remove`, so the repo's Worktrunk hooks run, e.g.
# to give each worktree its own database). Usually set per project, in
# projects/<project>/project.env. See SETUP.md.
WORKTREE_TOOL="git"

# Gardener settings.
GARDENER_LOOKBACK="14 days ago"   # range used on the first run for a project
GARDENER_MAX_TURNS=150
