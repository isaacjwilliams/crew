[Unit]
Description=crew gardener: review newly merged commits and write refactor proposals
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Includes mise's shims: a service never reads the shell config that puts mise's tools on your PATH.
Environment=PATH=%h/crew/bin:%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# When your crew home isn't ~/crew, crew install writes it into this unit: the
# %h/crew paths above and below, and this line, uncommented:
# Environment=CREW_HOME=/path/to/crew
ExecStart=%h/crew/bin/crew gardener --all
Nice=10
