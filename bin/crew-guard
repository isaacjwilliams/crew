#!/usr/bin/env bash
# crew-guard — PreToolUse hook that keeps each crew agent's file edits in bounds.
#   crew-guard <lead|worker|gardener>   (matcher: Edit|Write|NotebookEdit)
# Reads the hook JSON on stdin. Exit 0 allows the call; exit 2 blocks it and the
# message on stderr goes back to the agent.
#
# It checks only the file tools, whose target path is structured input, so no
# shell parsing is involved. Bash isn't checked: shell parsing can never be
# complete. Workers run it in auto mode, the gardener only with its read-only
# allow list, and the agent prompts say what they may do on GitHub.
set -uo pipefail
export LC_ALL=C

role=${1:-}
# The crew home: $CREW_HOME, else the directory above this script's bin/. Only its
# state paths, the ledger, take edits; the rest is crew itself. The same list as
# STATE_PATHS in crew.
home=${CREW_HOME:-$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")}
home=$(realpath -m "$home")
STATE_PATHS=(projects reports)

block() { echo "Blocked by crew-guard ($role): $*" >&2; exit 2; }

case $role in lead|worker|gardener) ;; *) block "usage: crew-guard <lead|worker|gardener>" ;; esac
command -v jq >/dev/null 2>&1 || block "jq is not installed, so this action can't be checked. Install jq."
input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input"); [[ -n $cwd ]] || cwd=$PWD

under() {  # path root
  [[ -n $2 ]] || return 1
  local r; r=$(realpath -m "$2")
  [[ $1 == "$r" || $1 == "$r"/* ]]
}

path=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input")
[[ -n $path ]] || exit 0
[[ $path == /* ]] || path="$cwd/$path"
path=$(realpath -m "$path")

if under "$path" "$home"; then
  for p in "${STATE_PATHS[@]}"; do under "$path" "$home/$p" && exit 0; done
  block "$path is part of crew itself. In the crew home only the ledger takes edits: $home/projects and $home/reports."
fi

for ok in "${TMPDIR:-/tmp}" /tmp "$HOME/.claude/jobs" "$HOME/.claude/plans" "${CLAUDE_JOB_DIR:-}"; do
  under "$path" "$ok" && exit 0
done

case $role in
  worker)
    # The session's project dir is where it was launched (its worktree), even if
    # it has since cd'd elsewhere.
    base=${CLAUDE_PROJECT_DIR:-$cwd}
    top=$(git -C "$base" rev-parse --show-toplevel 2>/dev/null || true)
    common=$(git -C "$base" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    main=${common:+$(dirname "$common")}
    [[ -n $top ]] || block "not inside a git worktree; workers only edit files in their own worktree."
    if [[ -n $main && $(realpath -m "$top") == $(realpath -m "$main") ]]; then
      block "this session is running in the main checkout ($top), not a crew worktree. Workers must be started with 'crew dispatch'."
    fi
    under "$path" "$top" && exit 0
    block "$path is outside your worktree ($top). Only edit files in your worktree, or the ledger via crew."
    ;;
  lead)     block "the lead only writes to the ledger ($home/projects, $home/reports). Put code changes in a task and dispatch it." ;;
  gardener) block "the gardener only writes proposals into the ledger ($home/projects)." ;;
esac
