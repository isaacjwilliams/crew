#!/usr/bin/env bash
# crew — the CLI for the lead / implementer / casual-observer / gardener crew.
# Run `crew help` for usage. All coordination state lives in the ledger, under
# projects/ in the crew home; nothing is written to the repositories themselves
# except local-only entries in .git/info/exclude.
set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || true

# The crew home is a clone of the crew repo: this script, its config, and the
# ledger. It's $CREW_HOME, else the directory above bin/, so a fresh clone works
# as it is. Exported, so the sessions and hooks crew starts find it too.
if [[ -z ${CREW_HOME:-} ]]; then CREW_HOME=$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")"); fi
export CREW_HOME
[[ -f "$CREW_HOME/config/defaults.env" ]] || { echo "crew: $CREW_HOME isn't a crew home (no config/defaults.env); set CREW_HOME?" >&2; exit 1; }
# Every setting has its default in defaults.env; config/crew.env holds the person's own.
load_config() {
  # shellcheck source=/dev/null
  . "$CREW_HOME/config/defaults.env"
  # shellcheck source=/dev/null
  if [[ -f $CREW_HOME/config/crew.env ]]; then . "$CREW_HOME/config/crew.env"; fi
}
load_config

REPLY_MARKER='<!-- crew -->'
ACTIVE_STATES="working needs-input addressing-feedback pr-open"
declare -A BRANCHES=()   # filled by load_branches

# ---------------------------------------------------------------- helpers ---

die()  { echo "crew: $*" >&2; exit 1; }
warn() { echo "crew: $*" >&2; }
# A refusal that only has to wait, such as a dispatch held by a cap: exit 4, so crew
# tick can try again later without reporting it as a failure.
not_yet() { echo "crew: $*" >&2; exit 4; }
now()  { date -Iseconds; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }
has_word() { [[ " $2 " == *" $1 "* ]]; }

# crew's locks, each on a file descriptor of its own:
#   fd 7  .crew-push.lock   one ledger push at a time (push_soon, crew tick's push)
#   fd 8  .crew-tick.lock   one crew tick at a time
#   fd 9  .crew.lock        every change to the ledger (lock)
# A lock is held by the open file, so a process that inherits the fd holds it too.

# Run claude outside any parent Claude Code session's environment, with all three
# lock fds closed, so a background supervisor started here can't hold them.
cc() { PATH="$CREW_HOME/bin:$PATH" env -u CLAUDECODE claude "$@" 7>&- 8>&- 9>&-; }

# Every change to the ledger takes the ledger lock with lock, which also checks
# that this machine runs the crew (require_host), so it can die with "crew runs
# on …". take_lock alone is for the commands that move the lease. The lock lasts
# until unlock or the end of the process. Opening .crew.lock again, even in the
# same process, waits for it.
take_lock() {
  exec 9>"$CREW_HOME/.crew.lock"
  flock -w 30 9 || die "ledger is locked by another crew command"
}
lock() { take_lock; require_host; }
unlock() { exec 9>&-; }

# The ledger: what crew and the agents write in the home. The rest of the home is
# crew's own code and config, which comes from upstream.
STATE_PATHS=(projects reports)

# Commits the ledger, and nothing else in the home, then starts a push in the
# background (push_soon). It never fails the command.
commit() {
  [[ $(git -C "$CREW_HOME" rev-parse --show-toplevel 2>/dev/null) == "$(realpath "$CREW_HOME")" ]] \
    || { warn "$CREW_HOME is not its own git repo; not committing"; return 0; }
  local p paths=()
  for p in "${STATE_PATHS[@]}"; do if [[ -e $CREW_HOME/$p ]]; then paths+=("$p"); fi; done
  ((${#paths[@]})) || return 0
  git -C "$CREW_HOME" add -A -- "${paths[@]}" >/dev/null 2>&1 || { warn "ledger commit failed (continuing)"; return 0; }
  git -C "$CREW_HOME" diff --cached --quiet -- "${paths[@]}" && return 0
  if git -C "$CREW_HOME" commit -qm "$1" -- "${paths[@]}" >/dev/null 2>&1; then push_soon
  else warn "ledger commit failed (continuing)"; fi
}

# ------------------------------------------------------------------ push ---
# The ledger goes to the home's origin, the person's private repo, soon after each
# commit, so a machine that dies loses seconds of decisions. A command never waits
# for that: push_soon pushes in the background. crew tick ends with a push in the
# foreground, which catches anything a background push missed.

# Whether origin has every ledger commit this machine has.
ledger_pushed() {
  [[ $(git -C "$CREW_HOME" rev-parse @ 2>/dev/null) == "$(git -C "$CREW_HOME" rev-parse '@{u}' 2>/dev/null)" ]]
}

# Takes in the commits origin has and this machine hasn't (one made on GitHub, or
# pushed from another clone), by rebasing the ledger onto them under the ledger
# lock, so no crew command commits meanwhile. Call it without the ledger lock.
# Fails if they moved the lease to another machine: that marks the lease lost
# (LEASE_LOST), and this machine must not push over them.
adopt_origin_commits() {
  git -C "$CREW_HOME" fetch -q origin || return 1
  if [[ $(origin_holder) != "$CREW_HOST" ]]; then
    touch "$LEASE_LOST"
    echo "origin says crew runs on $(origin_holder) now; not pushing. The next crew tick stands this machine down."
    return 1
  fi
  (
    exec 9>"$CREW_HOME/.crew.lock"
    flock -w 30 9 || exit 1
    git -C "$CREW_HOME" pull -q --rebase --autostash || { git -C "$CREW_HOME" rebase --abort 2>/dev/null; exit 1; }
  ) || { echo "couldn't rebase the ledger onto origin; leaving it for crew tick"; return 1; }
}

# Pushes until origin has every ledger commit: up to five tries, a second apart
# when the push fails for a reason like the network. A push origin rejects for
# commits it has that this machine lacks takes those in first.
push_ledger() {
  local out
  for _ in 1 2 3 4 5; do
    ledger_pushed && return 0
    if out=$(git -C "$CREW_HOME" push -q -u origin HEAD 2>&1); then continue; fi
    echo "$out"
    if [[ $out == *"[rejected]"* || $out == *"fetch first"* || $out == *"non-fast-forward"* ]]; then
      adopt_origin_commits || return 1
    else
      sleep 1
    fi
  done
  ledger_pushed
}

# Pushes in the foreground, after any background push that's running. Call it
# without the ledger lock.
push_now() {
  { flock -w 60 7 && push_ledger; } 7>"$CREW_HOME/.crew-push.lock"
}

# Starts a push in the background, logged to logs/push.log. It closes fds 8 and 9,
# so it never holds a lock the command that started it took. Pushes take turns on
# the push lock: one that finds another running exits and leaves the work to it.
# So the running one, after it lets go of the lock, loops to check again whether
# origin has everything: a commit made while it held the lock would otherwise wait
# for the next commit or tick.
push_soon() {
  git -C "$CREW_HOME" remote get-url origin >/dev/null 2>&1 || return 0
  mkdir -p "$CREW_HOME/logs"
  (
    exec 8>&- 9>&-
    while true; do
      { flock -n 7 || exit 0; push_ledger; } 7>"$CREW_HOME/.crew-push.lock" || exit 1
      ledger_pushed && exit 0
    done
  ) </dev/null >>"$CREW_HOME/logs/push.log" 2>&1 &
}

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'; }

# Main checkout root for any path inside a repo or one of its worktrees.
repo_root() {
  local common
  common=$(git -C "${1:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

slug_for() {
  local root=$1 url s owner repo
  url=$(git -C "$root" remote get-url origin 2>/dev/null || true)
  if [[ -n $url ]]; then
    s=${url%.git}; s=${s%/}; s=${s//://}
    repo=${s##*/}; s=${s%/*}; owner=${s##*/}
    slugify "$owner-$repo"
  else
    slugify "$(basename "$root")"
  fi
}

project_from_cwd() {
  local root s
  root=$(repo_root .) || return 1
  s=$(slug_for "$root")
  [[ -d "$CREW_HOME/projects/$s" ]] || return 1
  echo "$s"
}

# A project's settings: the shared ones, then its project.env (committed, the same on
# every machine: REMOTE, DEFAULT_BRANCH, overrides), then its local.env (this
# machine's REPO, never committed). Each project starts again from the shared
# settings, so crew tick doesn't carry one project's overrides into the next.
load_project() {
  PROJECT=$1
  PDIR="$CREW_HOME/projects/$1"
  [[ -f "$PDIR/project.env" ]] || die "unknown project '$1' (run 'crew project add' in the repo)"
  # load_config resets every setting defaults.env has. These three it hasn't.
  unset REPO REMOTE DEFAULT_BRANCH
  load_config
  # shellcheck source=/dev/null
  . "$PDIR/project.env"
  # shellcheck source=/dev/null
  if [[ -f $PDIR/local.env ]]; then . "$PDIR/local.env"; fi
  [[ -n ${REPO:-} && -d $REPO ]] || die "no clone of $1 on this machine (crew host up makes one, or run 'crew project add' in your clone of it)"
}

# The cwd's project, or every registered project when run outside one (or given "all").
projects_in_scope() {  # [all]
  local p
  if [[ ${1:-} != all ]] && p=$(project_from_cwd 2>/dev/null); then echo "$p"; return; fi
  for p in "$CREW_HOME"/projects/*/; do [[ -f $p/project.env ]] && basename "$p"; done
}

current_project_or_die() {
  project_from_cwd || die "this directory isn't in a repo registered with crew (run 'crew project add' there)"
}

# ------------------------------------------------------ front matter / md ---

fm_get() {
  K="$2" awk 'BEGIN{k=ENVIRON["K"]":"}
    NR==1 && $0=="---" {infm=1; next}
    infm && $0=="---" {exit}
    infm && index($0,k)==1 {
      v=substr($0, length(k)+1); sub(/^[ \t]+/,"",v); sub(/[ \t]+$/,"",v)
      if (v ~ /^".*"$/) { v=substr(v,2,length(v)-2); gsub(/\\"/,"\"",v) }
      print v; exit
    }' "$1"
}

fm_set() {
  local file=$1 key=$2 val=${3//$'\n'/ } tmp
  if [[ $val == *": "* || $val == *" #"* || $val == \"* || $val == *'"'* ]]; then
    val="\"${val//\"/\\\"}\""
  fi
  tmp=$(mktemp)
  K="$key" V="$val" awk 'BEGIN{k=ENVIRON["K"]; v=ENVIRON["V"]}
    NR==1 && $0=="---" {print; infm=1; next}
    infm && $0=="---" { if (!done) print k": "v; print; infm=0; next }
    infm && index($0, k":")==1 { if (!done) { print k": "v; done=1 }; next }
    {print}' "$file" >"$tmp" && cat "$tmp" >"$file"
  rm -f "$tmp"
}

touch_updated() { fm_set "$1" updated "$(now)"; }

ensure_trailing_newline() { [[ -z $(tail -c1 "$1") ]] || echo >>"$1"; }

append_log() {  # file message — the Log section is always last
  ensure_trailing_newline "$1"
  printf -- '- %s — %s\n' "$(date '+%Y-%m-%d %H:%M')" "$2" >>"$1"
}

insert_before_heading() {  # file heading contentfile
  local tmp; tmp=$(mktemp)
  if grep -qxF "$2" "$1"; then
    H="$2" CF="$3" awk 'BEGIN{h=ENVIRON["H"]; cf=ENVIRON["CF"]}
      $0==h && !done { while ((getline line < cf) > 0) print line; print ""; done=1 }
      {print}' "$1" >"$tmp" && cat "$tmp" >"$1"
  else
    ensure_trailing_newline "$1"; cat "$3" >>"$1"
  fi
  rm -f "$tmp"
}

# Adds the content at the end of a section, just before the next heading. A file
# without the section gets it, before ## Log.
append_to_section() {  # file heading contentfile
  local tmp; tmp=$(mktemp)
  if grep -qxF "$2" "$1"; then
    H="$2" CF="$3" awk 'BEGIN{h=ENVIRON["H"]; cf=ENVIRON["CF"]}
      function put() { while ((getline line < cf) > 0) print line; print ""; done=1 }
      on && /^## / && !done { put() }
      {print}
      $0==h {on=1}
      END { if (on && !done) { print ""; put() } }' "$1" >"$tmp" && cat "$tmp" >"$1"
  else
    printf '%s\n\n' "$2" >"$tmp"; cat "$3" >>"$tmp"
    insert_before_heading "$1" "## Log" "$tmp"
  fi
  rm -f "$tmp"
}

# Section text with HTML comments and blank lines removed.
section_body() {
  H="$2" awk 'BEGIN{h=ENVIRON["H"]}
    $0==h {on=1; next}
    on && /^## / {exit}
    on {
      line=$0; out=""
      while (length(line)) {
        if (inc) { p=index(line,"-->"); if (!p) { line=""; break }; line=substr(line,p+3); inc=0 }
        else { p=index(line,"<!--"); if (!p) { out=out line; line="" } else { out=out substr(line,1,p-1); line=substr(line,p+4); inc=1 } }
      }
      if (out ~ /[^ \t]/) print out
    }' "$1"
}

# An unchecked item under Open questions is a question still waiting on the user.
open_questions() {  # file -> how many there are
  section_body "$1" "## Open questions" | grep -c '^- \[ \]' || true
}

# ----------------------------------------------------------------- lease ---
# One machine runs the crew at a time: the one the home's `host` file names. A
# git push claims it (crew host up), so two machines can't both think they do.
# Every mutation checks it (lock), and so do the commands that start sessions,
# before they start one. Reads work on any machine.

CREW_HOST=${CREW_HOST:-$(hostname -s)}
CREW_UNITS=(crew-tick.timer crew-gardener.timer crew-lead.service)
# Made by a push that found on origin that another machine claimed the lease
# (adopt_origin_commits). require_host refuses every change while it exists; the
# next crew tick stands this machine down and removes it, as does crew host up.
LEASE_LOST=$CREW_HOME/.crew-lease-lost

lease_holder() { cat "$CREW_HOME/host" 2>/dev/null || true; }   # the machine the home's host file names, or nothing

# The holder as origin last told this machine, or nothing.
origin_holder() { git -C "$CREW_HOME" show '@{u}:host' 2>/dev/null || true; }

lease_since() { git -C "$CREW_HOME" log -1 --format=%cr -- host 2>/dev/null || true; }

# The last machine before this one that ran the crew. The host file names this
# machine now, so it's found in the file's history: the newest other name.
previous_holder() {
  local c h
  while IFS= read -r c; do
    h=$(git -C "$CREW_HOME" show "$c:host" 2>/dev/null || true)
    if [[ -n $h && $h != "$CREW_HOST" ]]; then echo "$h"; return 0; fi
  done < <(git -C "$CREW_HOME" log --format=%H -- host 2>/dev/null)
  echo "another machine"
}

# Fails unless this machine holds the lease: the host file names it, and no push
# has found that origin moved it elsewhere.
require_host() {
  local holder moved
  holder=$(lease_holder)
  if [[ -e $LEASE_LOST ]]; then
    moved=$(origin_holder)
    die "crew has moved to ${moved:-another machine}; this machine can only read until its next crew tick stands it down"
  fi
  [[ -n $holder ]] || die "no machine runs the crew; this one can only read (crew host up runs it here)"
  [[ $holder == "$CREW_HOST" ]] || die "crew runs on $holder; this machine can only read (crew host up --take moves it here)"
}

# This machine ran the crew, and origin, freshly fetched, says another one does
# now. A machine that never held the lease has nothing to stand down from.
lease_taken_elsewhere() {
  git -C "$CREW_HOME" fetch -q origin 2>/dev/null || return 1
  [[ $(origin_holder) != "$CREW_HOST" ]] || return 1
  [[ $(lease_holder) == "$CREW_HOST" || -e $LEASE_LOST ]]
}

set_units() {  # enable|disable — the crew's systemd units, now
  systemctl --user "$1" --now "${CREW_UNITS[@]}" >/dev/null 2>&1 || warn "couldn't $1 ${CREW_UNITS[*]} (systemctl --user)"
}

stop_crew_jobs() {  # every background session crew started on this machine
  local job
  while IFS= read -r job; do
    if [[ -n $job ]]; then stop_job "$job" || warn "background session $job didn't stop"; fi
  done < <(agents_json | jq -r '.[] | select((.name // "") | startswith("crew-")) | select(.pid != null) | .id')
}

# Commits the host file and pushes it in the foreground: a lease counts only once
# origin has it. A rejected push is expected when another machine moved first, so
# git's message is left out; the caller says what failed.
commit_host() {  # message
  git -C "$CREW_HOME" add -- host
  git -C "$CREW_HOME" diff --cached --quiet -- host || git -C "$CREW_HOME" commit -qm "$1" -- host
  git -C "$CREW_HOME" push -q -u origin HEAD 2>/dev/null
}

# Keeps what origin doesn't have, ledger commits and uncommitted changes alike, on
# a new branch, before stand_down resets the home. The working tree is committed
# through a scratch index, so the home's own index and files stay as they are.
save_lost_work() {  # branch
  local tmpidx tree tip
  tmpidx=$(mktemp)
  GIT_INDEX_FILE=$tmpidx git -C "$CREW_HOME" read-tree HEAD
  GIT_INDEX_FILE=$tmpidx git -C "$CREW_HOME" add -A
  tree=$(GIT_INDEX_FILE=$tmpidx git -C "$CREW_HOME" write-tree)
  rm -f "$tmpidx"
  tip=HEAD
  if [[ $tree != "$(git -C "$CREW_HOME" rev-parse 'HEAD^{tree}')" ]]; then
    tip=$(git -C "$CREW_HOME" commit-tree "$tree" -p HEAD -m "Uncommitted when $CREW_HOST stood down")
  fi
  git -C "$CREW_HOME" branch -q "$1" "$tip"
}

# Another machine has claimed the lease, so this one steps back: its units off,
# its sessions stopped, what origin lacks kept on lost/<host>-<time>, and its home
# reset to origin. Run with the tick lock held.
stand_down() {
  local holder=$1 lost
  echo "crew now runs on ${holder:-no machine}; standing down here"
  set_units disable
  stop_crew_jobs
  take_lock
  if [[ -n $(git -C "$CREW_HOME" status --porcelain) || -n $(git -C "$CREW_HOME" rev-list '@{u}..@' 2>/dev/null) ]]; then
    lost="lost/$CREW_HOST-$(date +%Y%m%d-%H%M%S)"
    save_lost_work "$lost"
    echo "kept what origin didn't have on $lost"
  fi
  git -C "$CREW_HOME" reset -q --hard '@{u}'
  rm -f "$LEASE_LOST"
  unlock
  echo "stood down: units disabled, crew sessions stopped, home reset to origin"
}

# Turns a fresh clone of the public crew repo into a person's own crew: a private
# GitHub repo becomes origin, the public one upstream, which can never be pushed
# to, so a ledger can't reach it. Then it writes their settings file and runs the
# crew on this machine. Once per person; another machine clones the private repo.
cmd_setup() {
  local name=crew login public
  while (($#)); do case $1 in --name) name=$2; shift 2 ;; *) die "usage: crew setup [--name NAME]" ;; esac; done
  need gh
  [[ ! -e $CREW_HOME/config/crew.env ]] || die "$CREW_HOME is set up already (config/crew.env exists)"
  public=$(git -C "$CREW_HOME" remote get-url origin 2>/dev/null) || die "$CREW_HOME has no origin; clone the public crew repo and run crew setup in it"
  login=$(gh api user --jq .login 2>/dev/null) || die "gh isn't signed in; run 'gh auth login' first"
  say "Making $login/$name, your private crew repo"
  git -C "$CREW_HOME" remote rename origin upstream
  # Not a URL, so any push to upstream fails.
  git -C "$CREW_HOME" remote set-url --push upstream DISABLED
  if ! (cd "$CREW_HOME" && gh repo create "$login/$name" --private --source . --remote origin >/dev/null); then
    git -C "$CREW_HOME" remote rename upstream origin
    git -C "$CREW_HOME" config --unset remote.origin.pushurl
    die "couldn't create $login/$name; if you have a repo by that name, pick another with crew setup --name NAME"
  fi
  note "origin: $(git -C "$CREW_HOME" remote get-url origin); upstream: $public (never pushed to)"
  cp "$CREW_HOME/templates/crew.env" "$CREW_HOME/config/crew.env"
  git -C "$CREW_HOME" add -- config/crew.env
  git -C "$CREW_HOME" commit -qm "crew: set up for $login" -- config/crew.env
  git -C "$CREW_HOME" push -q -u origin HEAD \
    || die "couldn't push to origin. Push with 'git -C $CREW_HOME push -u origin HEAD', then run crew host up"
  cmd_host_up
  say "Your crew is set up. Next:"
  cat <<NEXT
  1. Trust two folders once (accept, then /exit):   cd $WORK_ROOT; and claude
                                                    cd $CREW_HOME/lead; and claude
  2. Set BRANCH_PREFIX in $CREW_HOME/config/crew.env, then commit and push it.
  3. In each repo you want the crew to work on:   crew project add
  4. Talk to the lead: lead, or the crew session in the Claude app.
  See SETUP.md for the full walkthrough.
NEXT
}

# Brings in a new version of crew from the public repo (upstream). The ledger and
# the person's settings are paths the public repo never has, so the merge only
# meets their own edits to crew's code. A conflict there is theirs to settle:
# crew stops with the merge in progress and says how. Then the machine's files
# are installed again, the merge pushed, and the lead's server restarted, so new
# phone sessions run the new lead.
cmd_upgrade() {
  [[ $# == 0 ]] || die "usage: crew upgrade"
  git -C "$CREW_HOME" remote get-url upstream >/dev/null 2>&1 || die "the home has no upstream (the public crew repo) to upgrade from"
  lock
  [[ -z $(git -C "$CREW_HOME" status --porcelain) ]] \
    || die "the home has uncommitted changes; commit or discard them first (git -C $CREW_HOME status)"
  git -C "$CREW_HOME" fetch -q upstream || die "couldn't fetch upstream"
  local ref; ref=$(git -C "$CREW_HOME" symbolic-ref -q --short refs/remotes/upstream/HEAD || echo upstream/main)
  if ! git -C "$CREW_HOME" merge -q --no-edit "$ref"; then
    git -C "$CREW_HOME" status --short >&2
    die "upstream's changes conflict with edits in your home. The merge is left in progress: resolve the files above, then 'git -C $CREW_HOME commit' and run crew upgrade again. Or undo it with 'git -C $CREW_HOME merge --abort'."
  fi
  # The merge needed the lock (no ledger commits in the middle of it); installing
  # doesn't, and the push takes the lock itself if it has to rebase.
  unlock
  # The new version's crew installs it, so a change to installing takes effect now.
  "$CREW_HOME/bin/crew" install || die "couldn't install the new version; run crew install to try again"
  push_now || warn "couldn't push the upgrade to origin; crew tick pushes it later"
  systemctl --user restart crew-lead.service >/dev/null 2>&1 || warn "couldn't restart crew-lead.service"
  echo "crew upgraded to $(crew_version)"
}

# TEMPORARY: removed once the user's migration is done (plan step 10.4).
# Imports a ledger that install.sh made (~/agent-ledger) into this home, keeping
# its history. A temporary clone of it loses install.sh's copies of crew, turns
# each project's REPO into REMOTE (the REPO goes to this machine's local.env),
# and is merged in. The old ledger's settings that differ from defaults.env are
# written into the home's config/crew.env.

# A setting's value in an env file, as crew would see it: the file is sourced,
# not read, since a value may be written in more than one way.
env_value() {  # file key
  # shellcheck source=/dev/null
  (. "$1"; printf '%s' "${!2-}")
}

# The old crew.env's lines that set something other than the default.
old_settings_kept() {  # old-ledger
  local line
  while IFS= read -r line; do
    if [[ $(env_value "$1/config/crew.env" "${line%%=*}") != "$(env_value "$CREW_HOME/config/defaults.env" "${line%%=*}")" ]]; then
      echo "$line"
    fi
  done < <(grep -E '^[A-Z_][A-Z0-9_]*=' "$1/config/crew.env")
}

# Writes each setting line into the home's crew.env, in place of a line that sets
# the same key (the template's BRANCH_PREFIX, say), or at the end.
write_settings() {  # line...
  local f="$CREW_HOME/config/crew.env" line tmp
  touch "$f"
  for line; do
    tmp=$(mktemp)
    # awk takes the key and the line from the environment, so neither needs escaping.
    KEY="${line%%=*}=" LINE=$line awk 'index($0, ENVIRON["KEY"]) == 1 { if (!done) print ENVIRON["LINE"]; done = 1; next }
      { print } END { if (!done) print ENVIRON["LINE"] }' "$f" >"$tmp"
    cat "$tmp" >"$f"; rm -f "$tmp"
    note "setting kept: $line"
  done
}

cmd_migrate_ledger() {
  [[ $# == 1 ]] || die "usage: crew migrate-ledger OLD"
  local old tmp branch pd p repo remote f kept=()
  local -A repos=()
  old=$(realpath -e "$1" 2>/dev/null) || die "no ledger at $1"
  [[ -f $old/config/crew.env && $(git -C "$old" rev-parse --show-toplevel 2>/dev/null) == "$old" ]] \
    || die "$old isn't a ledger made by install.sh (no config/crew.env, or not its own git repo)"
  lock
  ! compgen -G "$CREW_HOME/projects/*/" >/dev/null || die "this home has projects already; migrate into a fresh home"
  say "Importing $old"
  mapfile -t kept < <(old_settings_kept "$old")
  for f in "$old"/config/*-settings.json; do
    if [[ -f $f && -f $f.dist ]] && ! cmp -s "$f" "$f.dist"; then
      warn "${f#"$old"/} has edits of yours that aren't carried over; copy what you need into the home's settings"
    fi
  done
  tmp=$(mktemp -d)
  git clone -q "$old" "$tmp/ledger"
  branch=$(git -C "$tmp/ledger" symbolic-ref --short HEAD)
  # What install.sh copied into the ledger: crew itself, its README, version and
  # .gitignore, and config/. The home has its own of each, and the old settings
  # that matter are in kept.
  git -C "$tmp/ledger" rm -rq --ignore-unmatch -- bin templates README.md .crew-version .gitignore config
  for pd in "$tmp"/ledger/projects/*/; do
    [[ -f $pd/project.env ]] || continue
    p=$(basename "$pd")
    repo=$(env_value "$pd/project.env" REPO)
    [[ -n $repo ]] || die "$p has no REPO in its project.env"
    remote=$(git -C "$repo" remote get-url origin 2>/dev/null) || die "$p: can't read the origin of its REPO, $repo"
    # project.env as crew project add writes it: REMOTE, shared by every machine.
    REMOTE=$remote awk '/^REPO=/ { print "REMOTE=\"" ENVIRON["REMOTE"] "\""; next } { print }' "$pd/project.env" >"$tmp/env"
    cat "$tmp/env" >"$pd/project.env"
    repos[$p]=$repo
  done
  git -C "$tmp/ledger" add -A
  git -C "$tmp/ledger" commit -qm "crew: import the ledger from install.sh's $old"
  git -C "$CREW_HOME" pull -q --no-rebase --no-edit --allow-unrelated-histories "$tmp/ledger" "$branch" \
    || die "merging the old ledger failed; see git -C $CREW_HOME status"
  rm -rf "$tmp"
  for p in "${!repos[@]}"; do
    cat >"$CREW_HOME/projects/$p/local.env" <<EOF
# This machine's clone of $p. Not committed: each machine has its own.
REPO="${repos[$p]}"
EOF
    note "$p: ${repos[$p]}"
  done
  if ((${#kept[@]})); then
    write_settings "${kept[@]}"
    git -C "$CREW_HOME" add -- config/crew.env
    git -C "$CREW_HOME" commit -qm "crew: keep the old ledger's settings" -- config/crew.env
  fi
  unlock
  push_now || warn "couldn't push to origin; crew tick pushes it later"
  say "Imported. For the move, in this order:"
  cat <<NEXT
  1. Turn off the old timers, if you haven't: systemctl --user disable --now crew-tick.timer crew-gardener.timer
     (crew setup's crew host up enabled this home's; check with crew doctor).
  2. For each task in flight, once it needs its worker: crew followup TASK --fresh --note "crew moved to $CREW_HOME"
     Its old session still runs on the old settings.
  3. Keep $old as an archive. Nothing reads it any more.
NEXT
}

# What crew-lead.service runs: the lead, as a Remote Control server in the home's
# lead/, so the person opens it from Claude Mobile. On a machine that doesn't run
# the crew it exits EXIT_NOT_HOST, which the unit takes as "don't restart"
# (RestartPreventExitStatus).
EXIT_NOT_HOST=3
cmd_serve() {
  [[ $# == 0 ]] || die "usage: crew serve"
  # In a subshell, so require_host's die (exit 1) becomes this exit code.
  (require_host) || exit "$EXIT_NOT_HOST"
  cd "$CREW_HOME/lead" || die "$CREW_HOME/lead is missing"
  # Without CLAUDECODE, as cc does, so it starts from inside a Claude session too.
  # This home's bin/ first, so the lead's sessions run this home's crew.
  # Without --continue: it fails when no earlier server ran here, and serves only
  # one session. A plain start brings back the last server's sessions, if it
  # stopped in the last few hours. same-dir keeps sessions in lead/, not in
  # worktrees of the home.
  PATH="$CREW_HOME/bin:$PATH" exec env -u CLAUDECODE \
    claude remote-control --name crew --spawn same-dir --permission-mode "$LEAD_PERMISSION_MODE"
}

cmd_host() {
  local sub=${1:-}
  shift || true
  case $sub in
    "") cmd_host_status ;;
    up) cmd_host_up "$@" ;;
    down) cmd_host_down "$@" ;;
    *) die "usage: crew host [up [--take] | down [--force]]" ;;
  esac
}

cmd_host_status() {
  local holder; holder=$(lease_holder)
  if [[ -n $holder ]]; then echo "crew runs on $holder (since $(lease_since))"
  else echo "no machine runs the crew"; fi
  echo "this machine: $CREW_HOST"
}

# Claims the lease for this machine by pushing the host file. A rejected push
# means another machine moved first: this claim is dropped and origin looked at
# again. Without take, a lease another machine holds is refused.
claim_lease() {  # take(0|1)
  local take=$1 holder claimed=0
  take_lock
  for _ in 1 2 3 4 5; do
    git -C "$CREW_HOME" pull -q --ff-only \
      || die "the home has ledger commits origin hasn't and origin has commits it hasn't; settle that first (git -C $CREW_HOME status)"
    holder=$(lease_holder)
    if [[ -n $holder && $holder != "$CREW_HOST" ]] && ((!take)); then
      die "crew runs on $holder (since $(lease_since)); crew host up --take moves it here"
    fi
    echo "$CREW_HOST" >"$CREW_HOME/host"
    if commit_host "host: $CREW_HOST"; then claimed=1; break; fi
    git -C "$CREW_HOME" reset -q --hard '@{u}' 2>/dev/null || true
  done
  ((claimed)) || die "couldn't push the lease to origin"
  rm -f "$LEASE_LOST"
  unlock
}

# Clones each registered project this machine has no clone of, into
# $WORK_ROOT/<p>/repo, and records it as this machine's (crew project add).
clone_missing_projects() {
  local pd p remote clone
  for pd in "$CREW_HOME"/projects/*/; do
    [[ -f $pd/project.env && ! -f $pd/local.env ]] || continue
    p=$(basename "$pd")
    # shellcheck source=/dev/null
    remote=$(. "$pd/project.env" && echo "${REMOTE:-}")
    [[ -n $remote ]] || { warn "$p has no REMOTE in project.env; run 'crew project add' in a clone of it"; continue; }
    clone="$WORK_ROOT/$p/repo"
    if [[ ! -d $clone/.git ]]; then
      mkdir -p "$(dirname "$clone")"
      git clone -q "$remote" "$clone" || { warn "couldn't clone $remote for $p"; continue; }
    fi
    (cmd_project_add "$clone" >/dev/null) || warn "couldn't register $clone for $p"
    note "$p: this machine's clone is $clone"
  done
}

cmd_host_up() {
  local take=0
  while (($#)); do case $1 in --take) take=1; shift ;; *) die "usage: crew host up [--take]" ;; esac; done
  git -C "$CREW_HOME" remote get-url origin >/dev/null 2>&1 || die "the home has no origin to claim the lease through"
  cmd_install
  say "Claiming the lease for $CREW_HOST"
  claim_lease "$take"
  note "crew runs on $CREW_HOST"
  clone_missing_projects
  set_units enable
  note "enabled ${CREW_UNITS[*]}"
  (cmd_doctor) || true
}

cmd_host_down() {
  local force=0 f wt id unpushed=()
  while (($#)); do case $1 in --force) force=1; shift ;; *) die "usage: crew host down [--force]" ;; esac; done
  lock
  # Work that exists only in this machine's worktrees would be lost to the next host.
  while IFS= read -r f; do
    wt=$(fm_get "$f" worktree); id=$(basename "$f" .md)
    [[ -n $wt && -d $wt ]] || continue
    if ! git -C "$wt" rev-parse --verify --quiet '@{u}' >/dev/null; then unpushed+=("$id: its branch was never pushed")
    elif [[ -n $(git -C "$wt" rev-list '@{u}..@') ]]; then unpushed+=("$id: $(git -C "$wt" rev-list --count '@{u}..@') commit(s) not pushed"); fi
  done < <(files_of tasks)
  if ((${#unpushed[@]})) && ((!force)); then
    printf '  %s\n' "${unpushed[@]}" >&2
    die "these worktrees have work origin doesn't; have their workers push, or use --force"
  fi
  set_units disable
  stop_crew_jobs
  # The push may have to take the ledger lock to rebase.
  unlock
  push_now >&2 || warn "couldn't push every ledger commit before handing over"
  take_lock
  : >"$CREW_HOME/host"
  commit_host "host: none ($CREW_HOST stepped down)" || die "couldn't push the handover to origin; crew still runs here as far as origin knows"
  echo "crew runs on no machine now; crew host up starts it on the next one"
}

# ------------------------------------------------------------- resolution ---

files_of() {  # kind(tasks|proposals) [project]
  local d
  if [[ -n ${2:-} ]]; then d=("$CREW_HOME/projects/$2/$1"); else d=("$CREW_HOME"/projects/*/"$1"); fi
  local x
  for x in "${d[@]}"; do [[ -d $x ]] && find "$x" -maxdepth 1 -name '*.md' -type f; done | sort
}

resolve_in() {  # arg files... ; 0 found, 1 none, 2 ambiguous
  local arg=$1; shift
  local f id matches=()
  if [[ $arg == \#* ]]; then
    local n=${arg#\#} pr
    for f; do pr=$(fm_get "$f" pr); [[ -n $pr && ${pr##*/} == "$n" ]] && matches+=("$f"); done
  else
    for f; do id=$(basename "$f" .md); [[ $id == "$arg" ]] && { echo "$f"; return 0; }; done
    if [[ $arg =~ ^[0-9]+$ ]]; then
      local p; p=$(printf '%03d' "$((10#$arg))")
      for f; do id=$(basename "$f" .md); [[ $id == "$p"-* ]] && matches+=("$f"); done
    else
      for f; do id=$(basename "$f" .md); [[ $id == *"$arg"* ]] && matches+=("$f"); done
    fi
  fi
  if ((${#matches[@]} == 1)); then echo "${matches[0]}"; return 0; fi
  if ((${#matches[@]} > 1)); then
    printf 'crew: "%s" is ambiguous:\n' "$arg" >&2
    printf '  %s\n' "${matches[@]##*/}" >&2
    return 2
  fi
  return 1
}

resolve() {  # kind arg
  local kind=$1 arg=$2 cur rc files=()
  if [[ -f $arg ]]; then realpath "$arg"; return 0; fi
  cur=$(project_from_cwd 2>/dev/null || true)
  if [[ -n $cur ]]; then
    mapfile -t files < <(files_of "$kind" "$cur")
    if ((${#files[@]})); then
      rc=0; resolve_in "$arg" "${files[@]}" || rc=$?
      ((rc == 0)) && return 0
      ((rc == 2)) && exit 1
    fi
  fi
  mapfile -t files < <(files_of "$kind")
  if ((${#files[@]})); then
    rc=0; resolve_in "$arg" "${files[@]}" || rc=$?
    ((rc == 0)) && return 0
    ((rc == 2)) && exit 1
  fi
  die "no ${kind%s} matches '$arg'"
}

task_project() { fm_get "$1" project; }

# ------------------------------------------------------------------ stacks ---
# A task is stacked when its `base` is another task's branch; that task is its
# parent. Nothing else records the relationship, so it can't disagree with `base`.

load_branches() {  # [project] — index task files by branch, for parent_of
  BRANCHES=()
  local f p b
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    p=${f%/tasks/*}; b=$(fm_get "$f" branch)
    if [[ -n $b ]]; then BRANCHES[${p##*/}:$b]=$f; fi
  done < <(files_of tasks "${1:-}")
}

parent_of() {  # file -> the parent task's file, or nothing (call load_branches first)
  local p=${1%/tasks/*} base found
  base=$(fm_get "$1" base)
  [[ -n $base ]] || return 0
  found=${BRANCHES[${p##*/}:$base]:-}
  if [[ -n $found && $found != "$1" ]]; then echo "$found"; fi
}

# The branch a task belongs on now: its own base, or, once its parent has merged,
# whatever the parent was based on (the default branch when a stack merges bottom-up).
effective_base() {  # file
  local f=$1 p n
  for ((n = 0; n < 50; n++)); do
    p=$(parent_of "$f")
    [[ -n $p && $(fm_get "$p" status) == merged ]] || break
    f=$p
  done
  fm_get "$f" base
}

# Why a stacked task's branch has to be rebased, or nothing: "<parent> merged",
# "<parent> abandoned", or "<parent> moved" when the parent's pushed branch has
# commits this one lacks. Reads the refs as last fetched; needs load_project.
restack_reason() {  # file
  local p pid branch tip
  p=$(parent_of "$1")
  [[ -n $p ]] || return 0
  branch=$(fm_get "$1" branch)
  git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch" || return 0
  pid=$(basename "$p" .md)
  case $(fm_get "$p" status) in
    merged) echo "$pid merged"; return 0 ;;
    abandoned) echo "$pid abandoned"; return 0 ;;
  esac
  tip=$(git -C "$REPO" rev-parse --verify --quiet "refs/remotes/origin/$(fm_get "$p" branch)^{commit}" || true)
  [[ -n $tip ]] || return 0
  git -C "$REPO" merge-base --is-ancestor "$tip" "refs/heads/$branch" || echo "$pid moved"
}

# The commit a stacked task's branch belongs on now: the tip of its effective base
# on origin, as last fetched. Empty if that branch isn't on origin.
restack_target() {  # file
  git -C "$REPO" rev-parse --verify --quiet "refs/remotes/origin/$(effective_base "$1")^{commit}" || true
}

# A stack restacks bottom-up: a parent that is about to be rebased would only move
# this task again.
parent_needs_restack() {  # file
  local p; p=$(parent_of "$1")
  [[ -n $p ]] && has_word "$(fm_get "$p" status)" "$ACTIVE_STATES" && [[ -n $(restack_reason "$p") ]]
}

# base_sha is the newest commit of the parent's branch that the task's own branch
# contains: where `git rebase --onto` has to cut. Once the parent is squash-merged
# or rebased, the merge base of the two branches falls back to a commit before the
# parent's work, so the recorded one is kept for as long as the task's branch still
# contains it. Returns 0 if it changed. Call with the lock held.
note_base_sha() {  # file parent-file
  local old mb branch
  old=$(fm_get "$1" base_sha); branch=refs/heads/$(fm_get "$1" branch)
  mb=$(git -C "$REPO" merge-base "refs/remotes/origin/$(fm_get "$2" branch)" "$branch" 2>/dev/null) || return 1
  [[ $mb != "$old" ]] || return 1
  if [[ -n $old ]] && git -C "$REPO" merge-base --is-ancestor "$old" "$branch" 2>/dev/null \
     && ! git -C "$REPO" merge-base --is-ancestor "$old" "$mb" 2>/dev/null; then
    return 1
  fi
  fm_set "$1" base_sha "$mb"
}

# ----------------------------------------------------------- agent sessions ---

# claude agents --json --all, or [] on failure. A live session whose transcript
# says its last turn has ended gets turnEnded: true (see JQ_BUSY).
agents_json() {
  local out s ended=()
  out=$(cc agents --json --all 2>/dev/null || true)
  jq -e 'type=="array"' >/dev/null 2>&1 <<<"$out" || { echo '[]'; return 0; }
  while IFS= read -r s; do
    if [[ -n $s ]] && turn_ended "$s"; then ended+=("$s"); fi
  done < <(jq -r '.[] | select(.state == "working" and .pid != null) | .sessionId // empty' <<<"$out")
  jq --args 'map(if (.sessionId as $s | $ARGS.positional | index($s)) then .turnEnded = true else . end)' \
    "${ended[@]}" <<<"$out"
}

# Whether a session's last turn has ended, read from its transcript: Claude Code
# writes a turn_duration entry when a turn ends, and a prompt or a reply once the
# next one starts. Fails when there's no transcript to read.
turn_ended() {  # session
  local t last
  t=$(compgen -G "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/*/$1.jsonl" | head -n 1 || true)
  [[ -n $t ]] || return 1
  last=$(tac "$t" | jq -nr 'first(inputs | select(.type == "user" or .type == "assistant" or .subtype == "turn_duration") | .type)' 2>/dev/null || true)
  [[ $last == system ]]
}

job_state() {  # agents_json job
  [[ -n $2 ]] || return 0
  jq -r --arg id "$2" 'first(.[] | select(.id==$id) | if .turnEnded then "idle, background task running"
    else .state + (if .waitingFor then " (" + .waitingFor + ")" else "" end) end) // empty' <<<"$1"
}

# A worker is busy while a turn runs or while its live process holds an open prompt,
# such as a permission dialog (status waiting). Anything else can take a followup,
# including a blocked worker: it ended its turn on a question for the user, and the
# answer is what the followup sends. A background shell the worker started, such as
# a dev server, keeps its state working and its status busy after the turn ends, so
# the turn counts as running only while its transcript says so (turnEnded).
JQ_BUSY='def busy: (.state == "working" and (.turnEnded | not)) or .status == "waiting";'

job_listed() {  # agents_json job — whether claude agents on this machine knows the job
  [[ -n $2 ]] || return 1
  jq -e --arg id "$2" 'any(.[]; .id==$id)' <<<"$1" >/dev/null 2>&1
}

job_busy() {  # agents_json job
  [[ -n $2 ]] || return 1
  jq -e --arg id "$2" "$JQ_BUSY"' any(.[]; .id==$id and busy)' <<<"$1" >/dev/null 2>&1
}


# Workers are the jobs the task files record, not sessions with a crew- name: a
# session Claude Code copies on resume gets a name of its own.
running_workers() {  # agents_json
  local f jobs=()
  while IFS= read -r f; do
    [[ -n $f ]] && jobs+=("$(fm_get "$f" worker_job)")
  done < <(files_of tasks)
  jq --args "$JQ_BUSY"' [.[] | select(.id as $id | $ARGS.positional | index($id)) | select(busy)] | length' \
    "${jobs[@]}" <<<"$1"
}

# Stops a background job and waits up to 10 seconds for its process to close. Its
# conversation is saved, and background shells it started, such as a dev server,
# keep running for its next process. Fails if the process is still open.
stop_job() {  # job
  cc stop "$1" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    agents_json | jq -e --arg id "$1" 'any(.[]; .id==$id and .pid != null)' >/dev/null || return 0
    sleep 0.5
  done
  return 1
}

# A background session that ended its turn keeps its process open for about an hour.
# Resuming it then starts a copy under a new session ("already running in the
# background"), so stop it first, and the resume continues it in place.
stop_idle_session() {  # agents_json session
  [[ -n $2 ]] || return 0
  local job
  while IFS= read -r job; do
    if [[ -n $job ]]; then stop_job "$job" || true; fi
  done < <(jq -r --arg s "$2" "$JQ_BUSY"' .[] | select(.sessionId==$s and .pid != null and (busy | not)) | .id' <<<"$1")
}

# Takes a worker out of agent view, stopping it first: `claude rm` isn't documented
# to end a process that's still open. Fails if the process won't close.
remove_worker() {  # job
  [[ -n $1 ]] || return 0
  local aj; aj=$(agents_json)
  jq -e --arg id "$1" 'any(.[]; .id==$id)' <<<"$aj" >/dev/null || return 0
  if jq -e --arg id "$1" 'any(.[]; .id==$id and .pid != null)' <<<"$aj" >/dev/null; then
    stop_job "$1" || return 1
  fi
  cc rm "$1" >/dev/null 2>&1 || warn "couldn't remove worker $1 from agent view; delete it in claude agents"
}

# Ends the background processes still running in a directory, such as a dev server
# a worker started in a background shell: stopping the worker leaves those running.
# Sends TERM, then KILL to any still running after 10 seconds. A process with a
# terminal is the user's, so it's left alone, and so are crew and the processes
# that started it. Reads /proc (Linux).
stop_processes_in() {  # dir
  local dir pid cwd stat tty p mine=" " pids=() left=()
  dir=$(realpath -e "$1" 2>/dev/null) || return 0
  p=$BASHPID
  while [[ -n $p && $p != 0 ]]; do
    mine+="$p "
    p=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$p/status" 2>/dev/null || true)
  done
  for pid in /proc/[0-9]*; do
    pid=${pid#/proc/}
    [[ $mine == *" $pid "* ]] && continue
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    [[ $cwd == "$dir" || $cwd == "$dir"/* ]] || continue
    # The 7th field of stat is the terminal; the 2nd, the command name, may hold spaces.
    stat=$(<"/proc/$pid/stat") || continue
    read -r _ _ _ _ tty _ <<<"${stat##*) }"
    if [[ $tty == 0 ]]; then pids+=("$pid"); fi
  done
  ((${#pids[@]})) || return 0
  echo "stopping ${#pids[@]} process(es) still running in $1"
  kill -TERM "${pids[@]}" 2>/dev/null || true
  # A process that has exited has no cwd, even before its parent reaps it.
  for _ in $(seq 1 20); do
    left=()
    for p in "${pids[@]}"; do readlink "/proc/$p/cwd" >/dev/null 2>&1 && left+=("$p"); done
    ((${#left[@]})) || return 0
    sleep 0.5
  done
  warn "killing ${#left[@]} process(es) in $1 that ignored TERM"
  kill -KILL "${left[@]}" 2>/dev/null || true
}

strip_ansi() { sed $'s/\e\\[[0-9;?]*[[:alpha:]]//g'; }

# The GitHub login crew acts for. crew tick sets GH_LOGIN once, so the tasks it
# checks don't each look it up again.
gh_login() {
  [[ -n ${GH_LOGIN:-} ]] || GH_LOGIN=$(gh api user --jq .login) || return 1
  echo "$GH_LOGIN"
}

# A stack counts once: a task stacked on another in-flight task isn't counted.
in_flight_count() {
  local f n=0 p
  load_branches
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    has_word "$(fm_get "$f" status)" "$ACTIVE_STATES" || continue
    p=$(parent_of "$f")
    if [[ -n $p ]] && has_word "$(fm_get "$p" status)" "$ACTIVE_STATES"; then continue; fi
    n=$((n + 1))
  done < <(files_of tasks)
  echo "$n"
}

# A launch has worked once the job's own process reports the session it loaded.
# A job's ID is the first 8 characters of its session ID. A process that has just
# started can report a new session ID for a moment, before it loads the one it
# resumes, so only a session ID that starts with the job ID counts. A resume of a
# session that can't be found shows up as a job that ends in `failed`.
wait_for_launch() {  # job -> prints the job's sessionId (empty if it never reported one); fails if the job failed
  local entry
  for _ in $(seq 1 60); do
    entry=$(agents_json | jq -c --arg id "$1" 'first(.[] | select(.id==$id)) // empty')
    if [[ -n $entry ]]; then
      [[ $(jq -r .state <<<"$entry") != failed ]] || return 1
      jq -er --arg id "$1" 'select(.pid != null and ((.sessionId // "") | startswith($id))) | .sessionId' <<<"$entry" 2>/dev/null \
        && return 0
    fi
    sleep 0.5
  done
  return 0
}

# Task worktrees are made and removed with plain `git worktree`, or with Worktrunk
# (`wt`) when the project sets WORKTREE_TOOL=worktrunk, so the repo's wt hooks run
# (per-worktree databases, services, dependency installs). crew never passes
# --yes: hooks the user hasn't approved make wt fail rather than run. Hook output
# goes to a log under $CREW_HOME/logs/ instead of the caller's terminal.
worktree_create() {  # path branch startref(empty: check out the existing branch) logfile
  local wt=$1 branch=$2 startref=$3 logf=$4
  mkdir -p "$(dirname "$wt")"
  prune_worktrees
  case $WORKTREE_TOOL in
    git)
      if [[ -n $startref ]]; then git -C "$REPO" worktree add --quiet --no-track -b "$branch" "$wt" "$startref"
      else git -C "$REPO" worktree add --quiet "$wt" "$branch"; fi ;;
    worktrunk)
      need wt
      local args=(switch --no-cd --format json --config-set "worktree-path=$(jq -rn --arg p "$wt" '$p | tojson')")
      [[ -n $startref ]] && args+=(--create --base "$startref")
      mkdir -p "$(dirname "$logf")"
      echo "== $(now) wt ${args[*]} $branch" >>"$logf"
      echo "Creating $wt with Worktrunk (hook output: $logf)"
      local out path
      if ! out=$(wt -C "$REPO" "${args[@]}" "$branch" 2>>"$logf"); then
        tail -n 15 "$logf" >&2
        die "wt couldn't create the worktree (full output in $logf). If its hooks need approval, run 'wt config approvals add' in $REPO."
      fi
      path=$(jq -r '.path // empty' <<<"$out" 2>/dev/null || true)
      [[ -n $path && $(realpath -m "$path") == $(realpath -m "$wt") ]] \
        || die "wt left $branch at '${path:-unknown}' instead of $wt; does the branch already have a worktree? (wt list)" ;;
    *) die "unknown WORKTREE_TOOL '$WORKTREE_TOOL' (use git or worktrunk)" ;;
  esac
}

worktree_remove() {  # path force(0|1) logfile
  local wt=$1 force=$2 logf=$3 flags=()
  ((force)) && flags=(--force)
  case $WORKTREE_TOOL in
    git) git -C "$REPO" worktree remove "${flags[@]}" "$wt" ;;
    worktrunk)
      need wt
      mkdir -p "$(dirname "$logf")"
      echo "== $(now) wt remove $wt" >>"$logf"
      # crew deletes merged branches itself, the same way for both tools.
      wt -C "$REPO" remove --no-delete-branch --foreground "${flags[@]}" "$wt" >>"$logf" 2>&1 \
        || { tail -n 15 "$logf" >&2; warn "full output in $logf"; return 1; } ;;
    *) die "unknown WORKTREE_TOOL '$WORKTREE_TOOL' (use git or worktrunk)" ;;
  esac
}

# Makes a task's worktree ready for a worker: creates it unless it exists, and
# copies the WORKTREE_COPY files from the main checkout. A missing worktree checks
# out the task's local branch. When there's none, it makes the branch from
# origin/<branch>, where another machine pushed it, or else starts it from
# origin/<base>. WORKTREE_FROM says which: local-branch, origin-branch or base, or
# nothing for a worktree that existed. For base, NEW_BRANCH_FROM is the commit the
# branch starts at.
# An existing worktree whose path the task file doesn't record yet (dispatch
# records it only after this succeeds) is left from a dispatch that failed while
# creating it, where Worktrunk's setup hooks may not have finished, so it's
# refused. Run it without the ledger lock: Worktrunk hooks can take minutes.
# Needs load_project.
setup_worktree() {  # file wt branch base -> sets WORKTREE_FROM NEW_BRANCH_FROM
  local file=$1 wt=$2 branch=$3 base=$4 id startref="" c
  id=$(basename "$file" .md)
  WORKTREE_FROM="" NEW_BRANCH_FROM=""
  if [[ -d $wt ]]; then
    git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$wt exists but isn't a git worktree"
    [[ $WORKTREE_TOOL != worktrunk || -n $(fm_get "$file" worktree) ]] \
      || die "$wt is left over from a dispatch whose Worktrunk setup failed; remove it with 'wt -C $REPO remove $wt' and dispatch again"
  else
    if git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch"; then
      WORKTREE_FROM=local-branch
    elif git -C "$REPO" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      WORKTREE_FROM=origin-branch; startref="origin/$branch"
    else
      WORKTREE_FROM=base; startref="origin/$base"
      git -C "$REPO" rev-parse --verify --quiet "$startref" >/dev/null || startref=$base
      NEW_BRANCH_FROM=$(git -C "$REPO" rev-parse --verify --quiet "$startref^{commit}" || true)
    fi
    worktree_create "$wt" "$branch" "$startref" "$CREW_HOME/logs/worktree-$PROJECT-$id.log"
  fi
  for c in $WORKTREE_COPY; do
    if [[ -e $REPO/$c && ! -e $wt/$c ]]; then mkdir -p "$(dirname "$wt/$c")"; cp -a "$REPO/$c" "$wt/$c"; fi
  done
}

# A task has been dispatched once crew records a worker or a worktree for it.
task_dispatched() { [[ -n $(fm_get "$1" worker_job) || -n $(fm_get "$1" worktree) ]]; }

# Makes sure a dispatched task's worktree is on this machine, at
# $WORK_ROOT/<p>/<id>. After a failover the task file names another machine's
# path, and the task's branch may be on origin only, or nowhere, if that machine
# never pushed it: then the branch starts over from its base. Records the path
# when it changes, and logs how a missing worktree came back. Run it without the
# ledger lock. Needs load_project.
ensure_worktree() {  # file
  local file=$1 id wt branch base msg=""
  id=$(basename "$file" .md); wt="$WORK_ROOT/$PROJECT/$id"
  branch=$(fm_get "$file" branch)
  base=$(fm_get "$file" base); base=${base:-$DEFAULT_BRANCH}
  if [[ ! -d $wt ]]; then
    git -C "$REPO" fetch --quiet origin 2>/dev/null || warn "git fetch origin failed; using local refs"
  fi
  setup_worktree "$file" "$wt" "$branch" "$base"
  case $WORKTREE_FROM in
    local-branch) msg="recreated worktree on the local branch $branch" ;;
    origin-branch) msg="recreated worktree from origin/$branch" ;;
    base) msg="started over: $branch was never pushed from $(previous_holder)" ;;
  esac
  if [[ $(fm_get "$file" worktree) == "$wt" && -z $msg ]]; then return 0; fi
  lock
  fm_set "$file" worktree "$wt"
  if [[ -n $NEW_BRANCH_FROM ]]; then fm_set "$file" base_sha "$NEW_BRANCH_FROM"; fi
  if [[ -n $msg ]]; then append_log "$file" "$msg"; fi
  touch_updated "$file"
  commit "worktree $PROJECT/$id"
  unlock
}

# A worktree or checkout deleted by hand (rm -rf) stays registered with git, which
# then refuses to make another at its path. Needs load_project.
prune_worktrees() { git -C "$REPO" worktree prune; }

# A read-only checkout of origin/DEFAULT_BRANCH for a session that reads the code
# but never changes it (the gardener, a goal lead, the lead). Plain git, never
# Worktrunk: nothing runs there, so it needs none of the repo's per-worktree
# setup. Needs load_project.
detached_checkout() {  # path
  git -C "$REPO" fetch --quiet origin "$DEFAULT_BRANCH" 2>/dev/null || warn "$PROJECT: fetch failed; using local origin/$DEFAULT_BRANCH"
  if [[ -d $1 ]]; then git -C "$1" checkout --quiet --detach "origin/$DEFAULT_BRANCH"
  else
    prune_worktrees
    mkdir -p "$(dirname "$1")"; git -C "$REPO" worktree add --quiet --detach "$1" "origin/$DEFAULT_BRANCH"
  fi
}

# The settings workers run with: config/worker-settings.json, plus the project's
# projects/<p>/worker-settings.json when it has one (for example, allow rules
# or env for that project's test commands). The project file can only add:
# objects are merged and arrays appended, but any value the base file sets wins,
# so a project can't drop a deny rule.
# Prints a path or a JSON string; `claude --settings` takes either. Also checks
# WORKER_AUTOCOMPACT_WINDOW, so a bad value stops a dispatch before its worktree exists.
worker_settings() {
  [[ $WORKER_AUTOCOMPACT_WINDOW =~ ^(auto|[0-9]+[kKmM]?)$ ]] \
    || die "WORKER_AUTOCOMPACT_WINDOW must be auto or a token count like 400k, not '$WORKER_AUTOCOMPACT_WINDOW'"
  local base="$CREW_HOME/config/worker-settings.json" extra="$PDIR/worker-settings.json"
  [[ -f $extra ]] || { echo "$base"; return; }
  jq -cs 'def add_only($a; $b):
            if ($a | type) == "object" and ($b | type) == "object" then
              reduce ($b | keys_unsorted[]) as $k ($a;
                .[$k] = (if $a | has($k) then add_only($a[$k]; $b[$k]) else $b[$k] end))
            elif ($a | type) == "array" and ($b | type) == "array" then $a + ($b - $a)
            else $a end;
          add_only(.[0]; .[1])' "$base" "$extra" 2>/dev/null \
    || die "$extra isn't valid JSON"
}

launch_worker() {  # file wt prompt mode(fresh|resume) -> sets LAUNCH_JOB LAUNCH_SESSION
  local settings=""
  if [[ $4 == fresh ]]; then settings=$(worker_settings) || return 1; fi
  launch_session "$1" worker "$2" "$3" "$4" --agent implementer --permission-mode "$WORKER_PERMISSION_MODE" \
    --autocompact "$WORKER_AUTOCOMPACT_WINDOW" --settings "$settings"
}

# Starts a background session for a ledger file, or resumes the one it records as
# <role>_session, and confirms it started. A fresh session gets the launch flags,
# the file's <role>_name and the ledger as an extra directory.
launch_session() {  # file role wt prompt mode(fresh|resume) [launch flags...] -> sets LAUNCH_JOB LAUNCH_SESSION
  local file=$1 role=$2 wt=$3 prompt=$4 mode=$5 out name session
  shift 5
  name=$(fm_get "$file" "${role}_name")
  session=$(fm_get "$file" "${role}_session")
  if [[ $mode == resume ]]; then
    # A background session keeps the options it was started with (agent, permission
    # mode, settings, --add-dir). Passing any launch flag again makes Claude Code
    # start a copy under a new session instead of continuing this one. So does a
    # process that's still open, hence stop_idle_session.
    stop_idle_session "$(agents_json)" "$session"
    out=$(cd "$wt" && cc --resume "$session" --bg "$prompt" 2>&1) || true
  else
    # --add-dir is variadic, so it must never be the last flag before the prompt.
    out=$(cd "$wt" && cc --name "$name" --add-dir "$CREW_HOME" --bg "$@" "$prompt" 2>&1) || true
  fi
  # The job ID can come wrapped in color codes, which would never match `claude agents`.
  out=$(strip_ansi <<<"$out")
  LAUNCH_JOB=$(grep -m1 '^backgrounded' <<<"$out" | awk '{print $3}' || true)
  if [[ -z $LAUNCH_JOB ]]; then
    echo "$out" >&2
    return 1
  fi
  # A session did start, so don't fall back to starting another one.
  [[ $LAUNCH_JOB =~ ^[[:alnum:]_-]+$ ]] \
    || die "claude started a session but crew can't read its job ID from this output; find it in 'claude agents' and record it with 'crew set':
$out"
  grep -i '^note:' <<<"$out" >&2 || true
  if ! LAUNCH_SESSION=$(wait_for_launch "$LAUNCH_JOB"); then
    warn "claude started job $LAUNCH_JOB, but it failed straight away (see 'claude agents')"
    return 1
  fi
  if [[ -z $LAUNCH_SESSION ]]; then
    warn "job $LAUNCH_JOB hasn't reported its session after 30s, so crew can't confirm it started or record its session; check 'claude agents', then record its session as ${role}_session in $file"
  elif [[ $mode == resume && $LAUNCH_SESSION != "$session" ]]; then
    warn "claude started a copy of session $session as $LAUNCH_SESSION; later followups resume the copy"
  fi
}

# Resumes the session a file records as <role>_session, or starts a fresh one when it
# records none, when fresh is 1, or when the resume fails. A fresh session gets the
# fresh prompt and then the prompt. Sets LAUNCH_MODE as well as LAUNCH_JOB and
# LAUNCH_SESSION.
relaunch() {  # launcher role file wt prompt fresh-prompt fresh(0|1)
  local launcher=$1 role=$2 file=$3 wt=$4 prompt=$5 fresh_prompt=$6 session
  session=$(fm_get "$file" "${role}_session")
  LAUNCH_MODE=resume
  if (($7)) || [[ -z $session ]]; then LAUNCH_MODE=fresh
  elif ! "$launcher" "$file" "$wt" "$prompt" resume; then
    warn "couldn't resume session $session; starting a fresh session instead"
    LAUNCH_MODE=fresh
  fi
  if [[ $LAUNCH_MODE == fresh ]]; then
    "$launcher" "$file" "$wt" "$fresh_prompt
$prompt" fresh || die "could not start a session (see output above)"
  fi
}

