cmd_help() {
  cat <<'EOF'
crew — ledger CLI for the agent crew

Setup
  crew setup [--name NAME]         Once, in a fresh clone of the public crew repo: make
                                   your private repo (NAME, default crew) its origin,
                                   with the public one as upstream, and run the crew here
  crew migrate-ledger OLD          Temporary, removed after the user's migration: import
                                   a ledger install.sh made (e.g. ~/agent-ledger), history
                                   and all, into this fresh home
  crew upgrade                     Merge the public repo's new version, install it,
                                   push, and restart the lead's server
  crew install [--yes] [--no-fish] [--no-systemd] [--skip-agents-md-setting]
                                   Put this machine's files in place: agents, fish
                                   functions, systemd units (timers not enabled)
  crew project add [PATH]          Register a repo (default: current) with the ledger,
                                   or this machine's clone of one registered already
  crew checkout PROJECT            Bring the lead's reading copy of PROJECT up to date
                                   with origin; prints its path
  crew host                        Which machine runs the crew, and this one's name
  crew host up [--take]            Run the crew on this machine: install, claim the
                                   lease (--take: from another machine), clone missing
                                   projects, enable the timers
  crew host down [--force]         Hand over: stop the crew here and release the lease
                                   (refused while a worktree has unpushed commits)
  crew serve                       Serve the lead with Remote Control (what
                                   crew-lead.service runs); exits 3 on a machine
                                   that doesn't run the crew
  crew doctor                      Check dependencies, versions, trust and settings
  crew config [KEY] [--project P]  Show effective config (project overrides applied:
                                   the current repo's, or P's)

Tasks  (TASK = id, number like 7, unique substring, "#<pr-number>", or file path)
  crew new "<title>" [--branch NAME] [--on TASK] [--goal GOAL] [--project P]
                                   Create a draft task; prints its path. NAME is the
                                   branch without BRANCH_PREFIX (default: from title).
                                   --on stacks it on TASK's unmerged branch; --goal
                                   makes it one of GOAL's tasks
  crew ready TASK                  Check the brief is complete and mark it ready
  crew dispatch TASK [--force]     Create worktree + branch and start an implementer
  crew feedback TASK [--since ISO]
                                   Pull new PR comments: yours into a review round,
                                   collaborators' under Open questions for you
  crew followup TASK [--fresh] [--note TEXT]
                                   Resume the task's worker on the latest round/note
  crew restack TASK [--again]      Have a stacked task's worker rebase it after its
                                   parent moved or merged (bottom of the stack first);
                                   --again resends a restack the worker already has
  crew reply TASK COMMENT_ID TEXT  Reply to a review comment, conversation comment or
                                   review summary on the task's PR (used by workers)
  crew status [--done]             Tasks with worker state (current project, or all);
                                   stacked tasks are listed under their parent
  crew sync [--quiet] [--all]      Pull PR URLs/states from GitHub; mark merged tasks;
                                   report stacked tasks that need a restack (current
                                   project, or all)
  crew tick                        Do what needs no decision, across all projects:
                                   sync, record new PR comments, send review rounds
                                   and restacks to idle workers, mark tasks waiting
                                   on you, clean up merged ones (run by a timer)
  crew list [--all] [--status S]   Compact task list
  crew show TASK | crew path TASK  Print a task file / its path
  crew find TASK                   Print the resolved task id
  crew get TASK KEY                Read a front-matter field
  crew set TASK KEY VALUE...       Write a front-matter field
  crew log TASK MESSAGE...         Append to the task's Log
  crew cleanup TASK|--merged [--force]
                                   Remove worktree/local branch of merged tasks
  crew commit [MESSAGE]            Commit pending ledger edits
  crew commit --hook               The same for one file, from an agent's PostToolUse
                                   hook JSON on stdin (always exits 0)

Goals  (GOAL = id, number, unique substring, or file path)
  crew goal new "<title>" [--project P]
                                   Create a draft goal; prints its path
  crew goal start GOAL             Start its goal lead, which plans every item
  crew goal note GOAL TEXT         Record your words under the goal's Decisions and
                                   pass them to its goal lead
  crew goal followup GOAL          Resume the goal lead with your unsent notes and its
                                   workers' new questions (run by crew tick)
  crew goal done GOAL              Close a goal whose tasks are all merged or abandoned
                                   (run by crew tick)
  crew goal abandon GOAL           Stop the goal lead; its tasks stay as they are
  crew goal path GOAL              Print the goal file's path

Review / gardening
  crew observe [TASK|PATH] [--base REF]
                                   Run the casual observer headless on a branch
  crew gardener [--all|PROJECT]    Run the gardener over newly merged commits
  crew proposals [--all]           List gardener proposals (open by default)
  crew promote PROPOSAL [--branch NAME]
                                   Turn a proposal into a draft task
EOF
}

cmd_config() {
  local key="" p=""
  while (($#)); do
    case $1 in
      --project) p=$2; shift 2 ;;
      *) key=$1; shift ;;
    esac
  done
  if [[ -n $p ]] || p=$(project_from_cwd 2>/dev/null); then load_project "$p"; fi
  local keys=(MAX_WORKERS MAX_IN_FLIGHT BRANCH_PREFIX WORK_ROOT WORKER_PERMISSION_MODE WORKER_AUTOCOMPACT_WINDOW LEAD_PERMISSION_MODE
              PRE_PR_REVIEW PR_MODE REPLY_TO_THREADS MAX_REVIEW_ROUNDS WORKTREE_COPY WORKTREE_TOOL GARDENER_LOOKBACK
              GARDENER_MAX_TURNS REMOTE REPO DEFAULT_BRANCH)
  if [[ -n $key ]]; then printf '%s\n' "${!key-}"; return; fi
  echo "CREW_HOME=$CREW_HOME"; [[ -n ${PROJECT:-} ]] && echo "PROJECT=$PROJECT"
  local k; for k in "${keys[@]}"; do printf '%s=%s\n' "$k" "${!k-}"; done
}

# Registers a repo: project.env records what every machine shares (its remote and
# default branch), and local.env this machine's clone. On a machine where the
# project is registered already, it records only the clone.
cmd_project_add() {
  need git
  local root slug dir def remote
  root=$(repo_root "${1:-.}") || die "not inside a git repository"
  remote=$(git -C "$root" remote get-url origin 2>/dev/null) || die "$root has no origin remote; crew works through origin"
  slug=$(slug_for "$root")
  dir="$CREW_HOME/projects/$slug"
  lock
  mkdir -p "$dir/tasks" "$dir/proposals" "$WORK_ROOT/$slug"
  def=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
  def=${def#origin/}
  if [[ -z $def ]]; then
    git -C "$root" remote set-head origin --auto >/dev/null 2>&1 || true
    def=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
    def=${def#origin/}
  fi
  [[ -n $def ]] || def=main
  if [[ ! -f $dir/project.env ]]; then
    cat >"$dir/project.env" <<EOF
# crew project settings for $slug. Any key from config/defaults.env can be overridden here.
REMOTE="$remote"
DEFAULT_BRANCH="$def"
# BRANCH_PREFIX="agent/"
# WORKTREE_COPY=".env.local"
# WORKTREE_TOOL="worktrunk"   # create/remove task worktrees with wt, so the repo's Worktrunk hooks run
# PR_MODE="draft"
# Extra worker settings for this project only (e.g. allow rules, env) go in
# worker-settings.json next to this file; see SETUP.md.
EOF
    echo "Registered $slug ($remote, default branch $def)."
  else
    echo "$slug is already registered; left project.env as is."
  fi
  # Written every time: this clone is the one this machine uses from now on.
  cat >"$dir/local.env" <<EOF
# This machine's clone of $slug. Not committed: each machine has its own.
REPO="$root"
EOF
  echo "This machine's clone: $root"
  local exclude line
  exclude="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$exclude")"; touch "$exclude"
  for line in ".claude/worktrees/" ".claude/settings.local.json"; do
    grep -qxF "$line" "$exclude" || echo "$line" >>"$exclude"
  done
  [[ -f $root/AGENTS.md ]] && echo "Found AGENTS.md: agents will load it automatically."
  if [[ -f $root/CLAUDE.md || -f $root/.claude/CLAUDE.md ]]; then
    if [[ -f $root/AGENTS.md ]]; then
      echo "Note: this repo has both CLAUDE.md and AGENTS.md. Claude Code reads only CLAUDE.md by default;"
      echo "      set Project instructions to claude-md-and-agents-md (see SETUP.md) to load both."
    fi
  elif [[ ! -f $root/AGENTS.md ]]; then
    echo "Note: no AGENTS.md or CLAUDE.md found. Agents will have no project conventions to follow."
  fi
  commit "project add $slug"
}

next_number() {  # kind(tasks|goals) project -> one more than the highest NNN- among its files
  local f n max=0
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    n=$(basename "$f"); n=${n%%-*}
    if [[ $n =~ ^[0-9]+$ ]] && ((10#$n > max)); then max=$((10#$n)); fi
  done < <(files_of "$1" "$2")
  echo $((max + 1))
}

branch_taken() {  # branch project
  git -C "$REPO" show-ref --verify --quiet "refs/heads/$1" && return 0
  git -C "$REPO" show-ref --verify --quiet "refs/remotes/origin/$1" && return 0
  local f
  while IFS= read -r f; do
    [[ -n $f && $(fm_get "$f" branch) == "$1" ]] && return 0
  done < <(files_of tasks "$2")
  return 1
}

cmd_new() {
  local title="" proj="" name="" on="" goal=""
  while (($#)); do
    case $1 in
      --project) proj=$2; shift 2 ;;
      --branch) name=$2; shift 2 ;;
      --on) on=$2; shift 2 ;;
      --goal) goal=$2; shift 2 ;;
      *) title="${title:+$title }$1"; shift ;;
    esac
  done
  [[ -n $title ]] || die 'usage: crew new "<title>" [--branch NAME] [--on TASK] [--goal GOAL] [--project P]'
  # The branch name also names the task id, its worktree and (with Worktrunk)
  # the per-worktree databases, so keep it short and filesystem-safe.
  if [[ -n $name ]] && ! [[ $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && ${#name} -le 40 ]]; then
    die "--branch '$name': use a few lowercase words joined by hyphens, at most 40 characters, without the prefix (e.g. fix-invoice-rounding)"
  fi
  [[ -n $proj ]] || proj=$(current_project_or_die)
  load_project "$proj"
  lock
  local n s id file branch content base=$DEFAULT_BRANCH parent="" pst pfiles=() gfile="" gfiles=()
  if [[ -n $goal ]]; then
    mapfile -t gfiles < <(files_of goals "$proj")
    gfile=$(resolve_in "$goal" "${gfiles[@]}") || die "--goal '$goal' doesn't match exactly one goal in $proj"
    has_word "$(fm_get "$gfile" status)" "draft running" \
      || die "goal $(basename "$gfile" .md) is '$(fm_get "$gfile" status)'; only a draft or running goal takes new tasks"
  fi
  if [[ -n $on ]]; then
    mapfile -t pfiles < <(files_of tasks "$proj")
    parent=$(resolve_in "$on" "${pfiles[@]}") || die "--on '$on' doesn't match exactly one task in $proj"
    pst=$(fm_get "$parent" status)
    ! has_word "$pst" "merged abandoned" || die "$(basename "$parent" .md) is '$pst', so it has no open branch to stack on"
    base=$(fm_get "$parent" branch)
  fi
  n=$(next_number tasks "$proj")
  if [[ -n $name ]]; then s=$name
  else s=$(slugify "$title"); s=${s:0:40}; s=${s%-}; fi
  [[ -n $s ]] || s="task-$n"
  id=$(printf '%03d-%s' "$n" "$s")
  branch="${BRANCH_PREFIX}${s}"
  if branch_taken "$branch" "$proj"; then branch="${branch}-$n"; fi
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "'$branch' isn't a valid branch name; check BRANCH_PREFIX"
  file="$PDIR/tasks/$id.md"
  content=$(<"$CREW_HOME/templates/task.md")
  content=${content//'{{ID}}'/$id}
  content=${content//'{{TITLE}}'/${title//\"/\'}}
  content=${content//'{{PROJECT}}'/$proj}
  content=${content//'{{BASE}}'/$base}
  content=${content//'{{BRANCH}}'/$branch}
  content=${content//'{{PRE_PR_REVIEW}}'/$PRE_PR_REVIEW}
  content=${content//'{{PR_MODE}}'/$PR_MODE}
  content=${content//'{{NOW}}'/$(now)}
  printf '%s\n' "$content" >"$file"
  if [[ -n $parent ]]; then fm_set "$file" depends_on "$(basename "$parent" .md)"; fi
  if [[ -n $gfile ]]; then fm_set "$file" goal "$(basename "$gfile" .md)"; fi
  append_log "$file" "created${parent:+, stacked on $(basename "$parent" .md)}${gfile:+, for goal $(basename "$gfile" .md)}"
  commit "new $proj/$id"
  echo "$file"
}

cmd_ready() {
  local file; file=$(resolve tasks "${1:?usage: crew ready TASK}")
  local missing=() h
  for h in "## Goal" "## Structure" "## Plan" "## Acceptance criteria"; do
    [[ -n $(section_body "$file" "$h") ]] || missing+=("${h#\#\# }")
  done
  ((${#missing[@]} == 0)) || die "brief is incomplete, fill in: ${missing[*]}"
  local st; st=$(fm_get "$file" status)
  [[ $st == draft || $st == ready ]] || die "task is '$st', not draft"
  lock
  fm_set "$file" status ready; touch_updated "$file"; append_log "$file" "marked ready"
  commit "ready $(basename "$file" .md)"
  echo "ready: $(basename "$file" .md)"
}

# Refuses a dispatch the user hasn't readied, and holds back (not_yet) one whose
# dependencies aren't merged, or that would exceed MAX_WORKERS / MAX_IN_FLIGHT. The task's parent, if it is
# stacked, is the one dependency that needn't be merged: cmd_dispatch requires
# its branch on origin instead. Call with the lock held.
dispatch_checks() {  # file force
  local file=$1 force=$2 id st dep deps depfile depst parent pst="" pfiles=()
  id=$(basename "$file" .md)
  st=$(fm_get "$file" status)
  [[ $st == ready || $force == 1 ]] || die "$id is '$st'; run 'crew ready $id' first"
  load_branches "$PROJECT"
  parent=$(parent_of "$file")
  [[ -z $parent ]] || pst=$(fm_get "$parent" status)
  [[ $pst != abandoned ]] || die "$id is stacked on $(basename "$parent" .md), which is abandoned; give it another base with 'crew set $id base <branch>'"
  deps=$(fm_get "$file" depends_on); deps=${deps//,/ }; deps=${deps//[\[\]]/}
  mapfile -t pfiles < <(files_of tasks "$PROJECT")
  for dep in $deps; do
    depfile=$(resolve_in "$dep" "${pfiles[@]}") || die "$id depends on '$dep', which doesn't match exactly one task in $PROJECT"
    [[ $depfile != "$parent" ]] || continue
    depst=$(fm_get "$depfile" status)
    [[ $depst == merged ]] || not_yet "$id depends on $(basename "$depfile" .md), which is '$depst' (must be merged)"
  done
  local aj running inflight
  aj=$(agents_json)
  running=$(running_workers "$aj")
  ((running < MAX_WORKERS)) || not_yet "$running workers already running (MAX_WORKERS=$MAX_WORKERS); leaving $id ready"
  inflight=$(in_flight_count)
  # A task stacked on one that's in flight joins a stack that is already counted.
  has_word "$pst" "$ACTIVE_STATES" || ((inflight < MAX_IN_FLIGHT)) || not_yet "$inflight tasks already in flight (MAX_IN_FLIGHT=$MAX_IN_FLIGHT); leaving $id ready"
}

cmd_dispatch() {
  need git; need jq; need claude
  require_host
  local arg="" force=0
  while (($#)); do case $1 in --force) force=1; shift ;; *) arg=$1; shift ;; esac; done
  local file; file=$(resolve tasks "${arg:?usage: crew dispatch TASK}")
  local id; id=$(basename "$file" .md)
  load_project "$(task_project "$file")"
  worker_settings >/dev/null
  local base branch wt name parent pid=""
  base=$(fm_get "$file" base); base=${base:-$DEFAULT_BRANCH}
  branch=$(fm_get "$file" branch)
  wt="$WORK_ROOT/$PROJECT/$id"

  lock
  load_branches "$PROJECT"
  parent=$(parent_of "$file")
  # A parent that merged before this task started leaves nothing to stack on, so
  # start from whatever the parent was based on.
  if [[ -n $parent && $(fm_get "$parent" status) == merged ]] \
     && ! git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch"; then
    base=$(effective_base "$file")
    fm_set "$file" base "$base"
    append_log "$file" "$(basename "$parent" .md) has merged; based on $base instead of its branch"
    parent=$(parent_of "$file")
  fi
  [[ -z $parent ]] || pid=$(basename "$parent" .md)
  dispatch_checks "$file" "$force"
  # Setting up the worktree can take minutes when the project's Worktrunk hooks
  # install dependencies or create databases, so don't hold the ledger lock (and
  # block every worker's `crew log`) meanwhile. The checks run again afterwards.
  unlock
  if ! git -C "$REPO" fetch --quiet origin "$base" 2>/dev/null; then
    # A stacked task's PR targets its parent's branch, so that has to be pushed first.
    [[ -z $parent || $(fm_get "$parent" status) == merged ]] \
      || not_yet "$id is stacked on $pid, whose branch $base isn't on origin yet; dispatch $id once that task's worker has pushed"
    warn "git fetch origin $base failed; using local refs"
  fi
  setup_worktree "$file" "$wt" "$branch" "$base"
  lock
  fm_set "$file" worktree "$wt"
  if [[ -n $NEW_BRANCH_FROM ]]; then fm_set "$file" base_sha "$NEW_BRANCH_FROM"; fi
  dispatch_checks "$file" "$force"

  name="crew-$PROJECT-$id"; name=${name:0:80}
  fm_set "$file" worker_name "$name"

  local prompt="You are the implementer for task $id in project $PROJECT.
Task file: $file
Worktree (your working directory): $wt
Branch: $branch, based on origin/$base.
Read the task file completely, then follow your first-run workflow. Update the ledger with \`crew log $id \"...\"\` and \`crew set $id <key> <value>\`."
  if [[ -n $parent ]]; then
    local ppr; ppr=$(fm_get "$parent" pr)
    prompt+="
This task is stacked on task $pid${ppr:+ (PR #${ppr##*/})}: $base is that task's branch, not the default branch. Your PR targets $base; see \"Stacked tasks\" in your instructions."
  fi
  launch_worker "$file" "$wt" "$prompt" fresh || die "could not start the worker session (see output above)"

  fm_set "$file" worker_job "$LAUNCH_JOB"
  fm_set "$file" worker_session "$LAUNCH_SESSION"
  fm_set "$file" status working
  touch_updated "$file"
  append_log "$file" "dispatched: worker $LAUNCH_JOB (session ${LAUNCH_SESSION:-unknown}) in $wt on $branch"
  commit "dispatch $PROJECT/$id"
  echo "dispatched $id → worker $LAUNCH_JOB ($name)"
  echo "  worktree: $wt"
  echo "  watch:    claude attach $LAUNCH_JOB   |   claude agents"
}

# Pulls the PR comments newer than feedback_since. The user's own become a review
# round for the worker. Collaborators' (people with write access, not bots) become
# unchecked items under Open questions: they wait for the user to decide what to do,
# and no agent answers them on its own. Anyone else's are left alone. Returns 3 if
# there was nothing new.
cmd_feedback() {
  need gh; need jq
  local arg="" since=""
  while (($#)); do
    case $1 in
      --since) since=$2; shift 2 ;;
      *) arg=$1; shift ;;
    esac
  done
  local file; file=$(resolve tasks "${arg:?usage: crew feedback TASK}")
  local id; id=$(basename "$file" .md)
  load_project "$(task_project "$file")"
  local pr num branch
  pr=$(fm_get "$file" pr); branch=$(fm_get "$file" branch)
  if [[ -z $pr ]]; then
    pr=$(cd "$REPO" && gh pr list --head "$branch" --state all --json url --jq '.[0].url // empty' 2>/dev/null || true)
    [[ -n $pr ]] || die "$id has no PR yet"
  fi
  num=${pr##*/}
  [[ -n $since ]] || since=$(fm_get "$file" feedback_since)
  [[ -n $since ]] || since="1970-01-01T00:00:00Z"
  local me; me=$(gh_login) || die "gh is not authenticated (run 'gh auth login')"
  local stamp; stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # $who and $mine are jq fragments, spliced into the programs below. $who gives
  # each comment .who: "me", "collaborator", or "other" (dropped here).
  local who='map(.who = if .user.login == $me then "me"
                       elif (.user.type // "") != "Bot" and ((.author_association // "") | IN("OWNER", "MEMBER", "COLLABORATOR")) then "collaborator"
                       else "other" end)
             | map(select(.who != "other" and (((.body // "") | contains($marker)) | not)))'
  local allreviews reviews inline convo
  allreviews=$(cd "$REPO" && gh api "repos/{owner}/{repo}/pulls/$num/reviews" --paginate --jq '.[]' | jq -s .)
  reviews=$(jq --arg me "$me" --arg since "$since" --arg marker "$REPLY_MARKER" \
    "$who"' | map(select((.submitted_at // "") > $since and (.body // "") != ""))' <<<"$allreviews")
  inline=$(cd "$REPO" && gh api "repos/{owner}/{repo}/pulls/$num/comments" --paginate --jq '.[]' \
    | jq -s --arg me "$me" --arg since "$since" --arg marker "$REPLY_MARKER" \
      --argjson rmap "$(jq 'map({key: (.id|tostring), value: {state, submitted_at}}) | from_entries' <<<"$allreviews")" \
      "$who"' | map(($rmap[(.pull_request_review_id // "" | tostring)] // null) as $r
                  | select(($r.state // "") != "PENDING")
                  | select((($r.submitted_at // .created_at) // "") > $since))')
  convo=$(cd "$REPO" && gh api "repos/{owner}/{repo}/issues/$num/comments" --paginate --jq '.[]' \
    | jq -s --arg me "$me" --arg since "$since" --arg marker "$REPLY_MARKER" \
      "$who"' | map(select(.created_at > $since))')

  local nr ni nc mine theirs
  mine='map(select(.who == "me"))'
  nr=$(jq "$mine | length" <<<"$reviews"); ni=$(jq "$mine | length" <<<"$inline"); nc=$(jq "$mine | length" <<<"$convo")
  theirs=$(jq -n --argjson r "$reviews" --argjson i "$inline" --argjson c "$convo" \
    '[($r[] | .kind = "review"), ($i[] | .kind = "inline"), ($c[] | .kind = "comment")] | map(select(.who == "collaborator"))')
  local no; no=$(jq length <<<"$theirs")
  if ((nr + ni + nc + no == 0)); then
    echo "No new review feedback on PR #$num since $since."
    return 3
  fi

  local q='def quote: (. // "") | gsub("\r"; "") | split("\n") | map("  > " + .) | join("\n");'
  local rounds roundf="" questf=""
  rounds=$(fm_get "$file" review_rounds); rounds=${rounds:-0}
  if ((nr + ni + nc)); then
    rounds=$((rounds + 1)); roundf=$(mktemp)
    {
      echo "### Round $rounds — $(date '+%Y-%m-%d %H:%M') (PR #$num)"
      echo
      if ((nr)); then
        echo "**Review summaries**"
        jq -r "$q $mine"' | .[] | "- [ ] review \(.id) (\(.state | ascii_downcase))\n\(.body | quote)"' <<<"$reviews"
        echo
      fi
      if ((ni)); then
        echo "**Inline comments**"
        jq -r "$q $mine"' | .[] | "- [ ] `\(.path):\(.line // .original_line // "?")` — comment \(.id)\(if .in_reply_to_id then " (in thread \(.in_reply_to_id))" else "" end) — [link](\(.html_url))\n\(.body | quote)"' <<<"$inline"
        echo
      fi
      if ((nc)); then
        echo "**Conversation comments**"
        jq -r "$q $mine"' | .[] | "- [ ] comment \(.id) — [link](\(.html_url))\n\(.body | quote)"' <<<"$convo"
        echo
      fi
    } >"$roundf"
  fi
  if ((no)); then
    questf=$(mktemp)
    jq -r --arg num "$num" "$q"' .[]
      | "- [ ] @\(.user.login) " + (if .kind == "review" then "reviewed PR #\($num) (\(.state | ascii_downcase)), review \(.id)"
                                   elif .kind == "inline" then "commented on `\(.path):\(.line // .original_line // "?")` in PR #\($num), comment \(.id)"
                                   else "commented on PR #\($num), comment \(.id)" end)
        + " — [link](\(.html_url))\n\(.body | quote)"' <<<"$theirs" >"$questf"
  fi

  lock
  if [[ -n $roundf ]]; then
    insert_before_heading "$file" "## Log" "$roundf"
    fm_set "$file" review_rounds "$rounds"
    append_log "$file" "review round $rounds recorded ($nr reviews, $ni inline, $nc conversation)"
  fi
  if [[ -n $questf ]]; then
    append_to_section "$file" "## Open questions" "$questf"
    append_log "$file" "$no collaborator comment(s) recorded under Open questions for the user"
  fi
  fm_set "$file" pr "$pr"
  fm_set "$file" feedback_since "$stamp"
  touch_updated "$file"
  commit "feedback $PROJECT/$id"
  if [[ -n $questf ]]; then echo "For the user (under Open questions):"; cat "$questf"; rm -f "$questf"; fi
  [[ -n $roundf ]] || return 0
  cat "$roundf"; rm -f "$roundf"
  ((rounds <= MAX_REVIEW_ROUNDS)) || warn "this is round $rounds (MAX_REVIEW_ROUNDS=$MAX_REVIEW_ROUNDS); consider whether the plan needs a rethink"
}

cmd_followup() {
  need jq; need claude
  local arg="" fresh=0 note=""
  while (($#)); do
    case $1 in
      --fresh) fresh=1; shift ;;
      --note) note=$2; shift 2 ;;
      *) arg=$1; shift ;;
    esac
  done
  local file; file=$(resolve tasks "${arg:?usage: crew followup TASK [--fresh] [--note TEXT]}")
  local id; id=$(basename "$file" .md)
  load_project "$(task_project "$file")"
  worker_settings >/dev/null
  local wt job state aj
  job=$(fm_get "$file" worker_job)
  task_dispatched "$file" || die "$id has no worker yet; dispatch it first"
  aj=$(agents_json)
  state=$(job_state "$aj" "$job")
  local rounds sent new_round=0
  rounds=$(fm_get "$file" review_rounds); rounds=${rounds:-0}
  sent=$(fm_get "$file" last_round_sent); sent=${sent:-0}
  ((rounds > sent)) && new_round=1
  if job_busy "$aj" "$job"; then
    # A round sent any other way would go out again: only crew records last_round_sent.
    ((new_round)) && die "worker $job is busy ($state). crew tick sends round $rounds once it's free"
    die "worker $job is busy ($state). Wait for it, answer it in agent view (claude attach $job), or SendMessage $(fm_get "$file" worker_name) a note"
  fi
  ((new_round || ${#note})) || die "nothing new for $id: no new review round (run 'crew feedback $id') and no --note"
  ((rounds <= MAX_REVIEW_ROUNDS)) || warn "round $rounds exceeds MAX_REVIEW_ROUNDS=$MAX_REVIEW_ROUNDS"
  # The worktree may not be on this machine: the task moved here, say.
  ensure_worktree "$file"
  wt=$(fm_get "$file" worktree)

  local prompt
  prompt="New input for task $id (task file: $file)."
  if ((new_round)); then
    prompt+=" New review feedback is in Round $rounds under '## Review rounds'; follow your review-round workflow."
    if [[ $REPLY_TO_THREADS == yes ]]; then
      prompt+=" Reply to each comment in the round with \`crew reply\`."
    else
      prompt+=" Don't reply to the comments on the PR: this project has REPLY_TO_THREADS off."
    fi
  fi
  [[ -n $note ]] && prompt+=" Note from the lead (also check Decisions in the task file): $note"

  lock
  relaunch launch_worker worker "$file" "$wt" "$prompt" "You are picking up task $id in project $PROJECT, which already has work on its branch.
Task file: $file
Worktree (your working directory): $wt
Read the whole task file (including Decisions, Review rounds and Log) and inspect the branch (git log, gh pr view) before acting." "$fresh"
  fm_set "$file" worker_job "$LAUNCH_JOB"
  [[ -n $LAUNCH_SESSION ]] && fm_set "$file" worker_session "$LAUNCH_SESSION"
  fm_set "$file" last_round_sent "$rounds"
  if ((new_round)); then fm_set "$file" status addressing-feedback; else fm_set "$file" status working; fi
  touch_updated "$file"
  append_log "$file" "followup ($LAUNCH_MODE): worker $LAUNCH_JOB${note:+ — note: $note}"
  commit "followup $PROJECT/$id"
  echo "followup sent to $id → worker $LAUNCH_JOB ($LAUNCH_MODE)"
}

# Has a stacked task's worker rebase it after its parent moved or merged. crew only
# works out where to cut and what to rebase onto; the worker does the rebase, the
# push and the PR retarget, and records the new base when it has succeeded, so a
# failed restack still shows as one that's needed. restack_sent records the commit
# the last restack asked for, so the same restack isn't sent twice unless --again.
cmd_restack() {
  need git
  local arg="" again=0
  while (($#)); do case $1 in --again) again=1; shift ;; *) arg=$1; shift ;; esac; done
  local file; file=$(resolve tasks "${arg:?usage: crew restack TASK [--again]}")
  local id; id=$(basename "$file" .md)
  load_project "$(task_project "$file")"
  load_branches "$PROJECT"
  local parent pid base branch newbase reason target old note
  base=$(fm_get "$file" base); branch=$(fm_get "$file" branch)
  parent=$(parent_of "$file")
  [[ -n $parent ]] || die "$id isn't stacked: its base '$base' isn't another task's branch"
  pid=$(basename "$parent" .md)
  task_dispatched "$file" || die "$id has no branch yet; dispatch it first"
  # On a machine the task moved to, its branch may be on origin only.
  ensure_worktree "$file"
  git -C "$REPO" fetch --quiet origin 2>/dev/null || warn "git fetch failed; using local refs"
  lock
  if note_base_sha "$file" "$parent"; then commit "base_sha $PROJECT/$id"; fi
  unlock
  ! parent_needs_restack "$file" \
    || die "$pid needs a restack itself ($(restack_reason "$parent")); restack it first, a stack goes bottom-up"
  reason=$(restack_reason "$file")
  [[ -n $reason ]] || { echo "$id already sits on $pid's latest commit; nothing to restack"; return 0; }
  [[ $reason != *" abandoned" ]] || die "$pid is abandoned; give $id another base with 'crew set $id base <branch>' and tell its worker"
  newbase=$(effective_base "$file")
  target=$(restack_target "$file")
  [[ -n $target ]] || die "origin/$newbase doesn't exist, so there's nothing to restack $id onto"
  ((again)) || [[ $(fm_get "$file" restack_sent) != "$target" ]] \
    || die "$id's worker was already asked to restack onto ${target:0:12}; check its Open questions and log, or send it again with --again"
  old=$(fm_get "$file" base_sha)
  [[ -n $old ]] || die "$id has no base_sha (it was dispatched before crew recorded one). Find the last commit of $pid's in $branch and run 'crew set $id base_sha <sha>'"
  git -C "$REPO" merge-base --is-ancestor "$old" "refs/heads/$branch" 2>/dev/null \
    || die "$branch no longer contains $pid's commits (base_sha ${old:0:12}), so it looks restacked already. If it is, record it with 'crew set $id base $newbase'"
  note="Restack ($reason): rebase your branch with \`git fetch origin && git rebase --onto $target $old\`, then follow your restack workflow. $target is origin/$newbase now; $old is the last of $pid's commits in your branch."
  if [[ $newbase != "$base" ]]; then
    note+=" Your base is now $newbase: after pushing, run \`gh pr edit --base $newbase\` and \`crew set $id base $newbase\`."
  fi
  cmd_followup "$file" --note "$note"
  lock
  fm_set "$file" restack_sent "$target"
  commit "restack $PROJECT/$id"
}

# Replies to one of the review comments a round lists, on the task's own PR only.
# An inline comment gets a reply in its thread. A conversation comment or a review
# summary has no thread, so the reply is a new PR comment that quotes it first.
cmd_reply() {
  need gh; need jq
  local file; file=$(resolve tasks "${1:?usage: crew reply TASK COMMENT_ID TEXT}")
  local cid=${2:?comment id required}; shift 2
  local text="$*"; [[ -n $text ]] || die "reply text required"
  [[ $cid =~ ^[0-9]+$ ]] || die "comment id must be a number, not '$cid'"
  load_project "$(task_project "$file")"
  [[ $REPLY_TO_THREADS == yes ]] || die "REPLY_TO_THREADS is '$REPLY_TO_THREADS'; not replying"
  local pr; pr=$(fm_get "$file" pr); [[ -n $pr ]] || die "task has no PR"
  local num=${pr##*/} body="$text

$REPLY_MARKER" c
  if c=$(cd "$REPO" && gh api "repos/{owner}/{repo}/pulls/comments/$cid" 2>/dev/null); then
    jq -e --arg n "$num" '(.pull_request_url // "") | endswith("/pulls/" + $n)' <<<"$c" >/dev/null \
      || die "comment $cid isn't on PR #$num"
    # GitHub only accepts replies to a thread's top-level comment.
    local root; root=$(jq -r '.in_reply_to_id // .id' <<<"$c")
    (cd "$REPO" && gh api --silent "repos/{owner}/{repo}/pulls/$num/comments/$root/replies" -f body="$body")
    echo "replied to comment $cid in its thread"
    return
  fi
  local kind
  if c=$(cd "$REPO" && gh api "repos/{owner}/{repo}/issues/comments/$cid" 2>/dev/null); then
    jq -e --arg n "$num" '(.issue_url // "") | endswith("/issues/" + $n)' <<<"$c" >/dev/null \
      || die "comment $cid isn't on PR #$num"
    kind=Comment
  elif c=$(cd "$REPO" && gh api "repos/{owner}/{repo}/pulls/$num/reviews/$cid" 2>/dev/null); then
    kind=Review
  else
    die "$cid isn't a review comment, conversation comment or review on PR #$num"
  fi
  local quote
  quote=$(jq -r --arg kind "$kind" '((.body // "") | gsub("\r"; "") | split("\n") | map(select(test("\\S"))) | first // "") as $l
    | "> [\($kind)](\(.html_url)): " + (if ($l | length) > 120 then $l[:117] + "…" else $l end)' <<<"$c")
  (cd "$REPO" && gh api --silent "repos/{owner}/{repo}/issues/$num/comments" -f body="$quote

$body")
  echo "replied to ${kind,,} $cid on PR #$num"
}

pr_summary() {  # pr-url -> "#N state"
  local pr=$1
  [[ -n $pr ]] || { echo "-"; return; }
  echo "#${pr##*/}"
}

status_shown() { [[ $done_too == 1 ]] || ! has_word "$(fm_get "$1" status)" "merged done abandoned"; }

# A goal, then its tasks. Reads cmd_status's aj and goal_roots.
goal_row() {  # goal-file
  local g=$1 id ls f total=0 merged=0
  id="goal $(basename "$g" .md)"; id=${id:0:34}
  ls=$(job_state "$aj" "$(fm_get "$g" lead_job)")
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    total=$((total + 1))
    if [[ $(fm_get "$f" status) == merged ]]; then merged=$((merged + 1)); fi
  done < <(goal_tasks "$g")
  printf '  %s%*s %-20s %-26s %s\n' "$id" $((34 - ${#id})) "" "$(fm_get "$g" status)" "${ls:+lead: $ls}" "$merged of $total task(s) merged"
  while IFS= read -r f; do
    if [[ -n $f ]]; then status_row "$f" "  "; fi
  done <<<"${goal_roots[$(basename "$g" .md)]:-}"
}

# One task, then the tasks stacked on it. Reads cmd_status's aj, kids and p.
status_row() {  # file indent
  local f=$1 id st ws pr prs note reason="" k q
  id="$2$(basename "$f" .md)"
  st=$(fm_get "$f" status)
  ws=$(job_state "$aj" "$(fm_get "$f" worker_job)")
  pr=$(pr_summary "$(fm_get "$f" pr)")
  prs=$(fm_get "$f" pr_state)
  if has_word "$st" "$ACTIVE_STATES"; then
    reason=$( (load_project "$p" && restack_reason "$f") 2>/dev/null || true)
  fi
  note=${prs:+($prs)}
  [[ -z $reason ]] || note="${note:+$note  }needs restack: $reason"
  q=$(open_questions "$f")
  ((q == 0)) || note="${note:+$note  }$q open question(s)"
  # Padded by hand: printf counts the bytes of the tree marker, not its width.
  id=${id:0:34}
  printf '  %s%*s %-20s %-26s %-6s %s\n' "$id" $((34 - ${#id})) "" "$st" "${ws:+worker: $ws}" "$pr" "$note"
  while IFS= read -r k; do
    if [[ -n $k ]]; then status_row "$k" "${2//└ /  }└ "; fi
  done <<<"${kids[$f]:-}"
}

cmd_status() {
  need jq
  local done_too=0
  [[ ${1:-} == --done ]] && done_too=1
  local projects=() p
  mapfile -t projects < <(projects_in_scope)
  local holder; holder=$(lease_holder)
  if [[ $holder != "$CREW_HOST" ]]; then
    # Another machine runs the crew and pushes the ledger; catch up with it. No
    # crew command changes the ledger here, so this needs no lock.
    git -C "$CREW_HOME" pull -q --ff-only 2>/dev/null || true
    holder=$(lease_holder)
    echo "read-only: crew runs on ${holder:-no machine}"
    mapfile -t projects < <(projects_in_scope)
  fi
  ((${#projects[@]})) || { echo "No projects registered. Run 'crew project add' in a repo."; return; }
  local aj; aj=$(agents_json)
  echo "workers running: $(running_workers "$aj")/$MAX_WORKERS   tasks in flight: $(in_flight_count)/$MAX_IN_FLIGHT"
  local f parent nprop
  for p in "${projects[@]}"; do
    echo
    echo "$p"
    load_branches "$p"
    local roots=() goals=() g
    local -A kids=() goal_roots=()
    while IFS= read -r g; do
      if [[ -n $g ]] && status_shown "$g"; then goals+=("$g"); fi
    done < <(files_of goals "$p")
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      status_shown "$f" || continue
      parent=$(parent_of "$f")
      g=$(fm_get "$f" goal)
      if [[ -n $parent ]] && status_shown "$parent"; then kids[$parent]+="$f"$'\n'
      elif [[ -n $g ]] && has_word "$CREW_HOME/projects/$p/goals/$g.md" "${goals[*]}"; then goal_roots[$g]+="$f"$'\n'
      else roots+=("$f"); fi
    done < <(files_of tasks "$p")
    ((${#roots[@]} + ${#goals[@]})) || echo "  (no active tasks)"
    for g in "${goals[@]}"; do goal_row "$g"; done
    for f in "${roots[@]}"; do status_row "$f" ""; done
    nprop=0
    while IFS= read -r f; do
      [[ -n $f && $(fm_get "$f" status) == open ]] && nprop=$((nprop + 1))
    done < <(files_of proposals "$p")
    ((nprop == 0)) || echo "  open gardener proposals: $nprop  (crew proposals)"
  done
}

cmd_sync() {
  need gh; need jq
  local quiet=0 scope="" p projects=()
  while (($#)); do case $1 in --quiet) quiet=1; shift ;; --all) scope=all; shift ;; *) die "usage: crew sync [--quiet] [--all]" ;; esac; done
  mapfile -t projects < <(projects_in_scope "$scope")
  lock
  local f id st pr branch info state draft decision updated label changed=0 parent reason fetched
  for p in "${projects[@]}"; do
    load_project "$p"
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      st=$(fm_get "$f" status)
      has_word "$st" "draft ready merged abandoned" && continue
      id=$(basename "$f" .md)
      pr=$(fm_get "$f" pr); branch=$(fm_get "$f" branch)
      if [[ -z $pr && -n $branch ]]; then
        pr=$(cd "$REPO" && gh pr list --head "$branch" --state all --json url --jq '.[0].url // empty' 2>/dev/null || true)
        if [[ -n $pr ]]; then fm_set "$f" pr "$pr"; changed=1; ((quiet)) || echo "$id: found PR $pr"; fi
      fi
      [[ -n $pr ]] || continue
      info=$(cd "$REPO" && gh pr view "$pr" --json state,isDraft,reviewDecision,updatedAt 2>/dev/null) || { warn "$id: couldn't read $pr"; continue; }
      state=$(jq -r .state <<<"$info"); draft=$(jq -r .isDraft <<<"$info"); decision=$(jq -r '.reviewDecision // ""' <<<"$info")
      # For pr_may_have_new_comments.
      updated=$(jq -r '.updatedAt // ""' <<<"$info")
      if [[ $(fm_get "$f" pr_updated) != "$updated" ]]; then fm_set "$f" pr_updated "$updated"; changed=1; fi
      case $state in
        MERGED) label=merged ;;
        CLOSED) label=closed ;;
        *) label=$([[ $draft == true ]] && echo draft || echo open)
           [[ -n $decision ]] && label+=", $(tr '[:upper:]_' '[:lower:] ' <<<"$decision")" ;;
      esac
      if [[ $(fm_get "$f" pr_state) != "$label" ]]; then fm_set "$f" pr_state "$label"; changed=1; fi
      if [[ $state == MERGED && $st != merged ]]; then
        fm_set "$f" status merged; touch_updated "$f"; append_log "$f" "PR merged"; changed=1
        echo "$id: merged (run 'crew cleanup $id')"
      elif [[ $state == CLOSED && $st != abandoned ]]; then
        ((quiet)) || echo "$id: PR closed without merging (status left as '$st')"
      fi
    done < <(files_of tasks "$p")
    # Stacked tasks: say which need a restack, now that the merges above are known.
    load_branches "$p"; fetched=0
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      has_word "$(fm_get "$f" status)" "$ACTIVE_STATES" || continue
      parent=$(parent_of "$f")
      [[ -n $parent ]] || continue
      if ((!fetched)); then
        git -C "$REPO" fetch --quiet origin 2>/dev/null || warn "$p: git fetch failed; checking stacks against local refs"
        fetched=1
      fi
      if note_base_sha "$f" "$parent"; then changed=1; fi
      reason=$(restack_reason "$f"); id=$(basename "$f" .md)
      [[ -z $reason ]] || ((quiet)) || echo "$id: needs a restack, $reason (run 'crew restack $id')"
    done < <(files_of tasks "$p")
  done
  ((changed)) && commit "sync"
  ((quiet)) || echo "sync done"
}

# One pass over every project, doing what needs no decision: sync with GitHub,
# record new PR comments, send review rounds and restacks to idle workers, mark
# tasks that wait on the user, and clean up merged ones. The crew-tick timer runs
# it every few minutes; the lead runs it too. Every step is a crew command run in a
# subshell, so one that refuses (its `die`) skips that step and not the rest.
# Prints one line per thing it did.
cmd_tick() {
  need gh; need jq; need claude
  [[ $# == 0 ]] || die "usage: crew tick"
  exec 8>"$CREW_HOME/.crew-tick.lock"
  flock -n 8 || { echo "another crew tick is running"; return 0; }
  # A machine that ran the crew, and finds on origin that another one does now,
  # steps back and does nothing else.
  if lease_taken_elsewhere; then stand_down "$(origin_holder)"; return 0; fi
  require_host
  GH_LOGIN=$(gh_login) || die "gh is not authenticated (run 'gh auth login')"
  (cmd_sync --quiet --all) >/dev/null || warn "sync failed; carrying on with what the ledger has"
  local p f aj
  aj=$(agents_json)
  while IFS= read -r p; do
    # load_project dies on a broken project.env; try it in a subshell first, so
    # one broken project doesn't stop the tick for the others.
    (load_project "$p") || { warn "$p: skipped"; continue; }
    load_project "$p"
    load_branches "$p"
    while IFS= read -r f; do
      if [[ -n $f ]]; then tick_task "$f" "$aj"; fi
    done < <(files_of tasks "$p")
    while IFS= read -r f; do
      if [[ -n $f ]]; then tick_goal "$f" "$aj"; fi
    done < <(files_of goals "$p")
  done < <(projects_in_scope all)
  # A catch-all for background pushes that failed, or that a crash cut short.
  if git -C "$CREW_HOME" remote get-url origin >/dev/null 2>&1; then
    push_now >&2 || warn "couldn't push the ledger to origin; the next tick tries again"
  fi
}

goal_has_input() {  # goal-file
  local t n
  n=$(fm_get "$1" unsent_notes)
  ((${n:-0} == 0)) || return 0
  while IFS= read -r t; do
    if [[ -n $t ]] && unrouted_questions "$t" >/dev/null; then return 0; fi
  done < <(goal_tasks "$1")
  return 1
}

# One running goal's share of a tick: pass the goal lead its input once it's free,
# or close the goal once its tasks are all merged or abandoned.
tick_goal() {  # goal-file agents_json
  local g=$1 aj=$2 id job
  id=$(basename "$g" .md)
  [[ $(fm_get "$g" status) == running ]] || return 0
  job=$(fm_get "$g" lead_job)
  if goal_has_input "$g"; then
    if job_busy "$aj" "$job"; then echo "goal $id: input waits for its goal lead ($(job_state "$aj" "$job"))"
    elif (cmd_goal_followup "$g") >/dev/null; then echo "goal $id: input sent to its goal lead"; fi
  elif goal_finished "$g" && ! job_busy "$aj" "$job"; then
    if (cmd_goal_done "$g") >/dev/null; then echo "goal $id: done, every task merged or abandoned"; fi
  fi
}

# A task in progress that moved here from another machine: crew records a worktree
# for it that isn't here, and this machine's claude agents doesn't know its worker,
# whose session stayed behind. The fresh worker crew tick then starts is recorded,
# and listed by the next tick, so this holds once.
moved_here() {  # file agents_json
  local wt; wt=$(fm_get "$1" worktree)
  has_word "$(fm_get "$1" status)" "working addressing-feedback" && [[ -n $wt && ! -d $wt ]] && ! job_listed "$2" "$(fm_get "$1" worker_job)"
}

# GitHub moves a PR's updatedAt (recorded as pr_updated by crew sync) whenever a
# comment is posted or a review submitted. A PR that hasn't changed since crew
# feedback last read it has no new comments, and reading them costs three API calls.
# Without either timestamp, assume it may have some.
pr_may_have_new_comments() {  # file
  local updated since
  updated=$(fm_get "$1" pr_updated); since=$(fm_get "$1" feedback_since)
  [[ -z $updated || -z $since || $updated > $since ]]
}

# One task's share of a tick. Needs load_project and load_branches.
tick_task() {  # file agents_json
  local f=$1 aj=$2 id st rounds sent asked waiting reason target job
  id=$(basename "$f" .md); st=$(fm_get "$f" status)
  if [[ $st == ready ]] && goal_running "$f"; then
    # The goal lead marked it ready, which is the go-ahead. A dispatch that has to
    # wait for a cap or a dependency (exit 4) is tried again on the next tick.
    local rc=0 err
    err=$( (cmd_dispatch "$f") 2>&1 >/dev/null ) || rc=$?
    case $rc in
      0) echo "$id: dispatched for goal $(fm_get "$f" goal)" ;;
      4) ;;
      *) warn "$id: dispatch failed: $err" ;;
    esac
    return 0
  fi
  if [[ $st == merged ]]; then
    # A cleanup that fails (uncommitted changes, say) warns, and is tried again next tick.
    if [[ -n $(fm_get "$f" worktree) ]] && (cmd_cleanup "$f") >/dev/null; then echo "$id: merged; worktree cleaned up"; fi
    return 0
  fi
  has_word "$st" "$ACTIVE_STATES" || return 0
  if [[ -n $(fm_get "$f" pr) ]] && pr_may_have_new_comments "$f"; then
    # crew feedback reports what it recorded only in the task file, so compare before and after.
    rounds=$(fm_get "$f" review_rounds); asked=$(open_questions "$f")
    if (cmd_feedback "$f") >/dev/null; then
      [[ $(fm_get "$f" review_rounds) == "$rounds" ]] || echo "$id: review round $(fm_get "$f" review_rounds) recorded"
      (($(open_questions "$f") == asked)) || echo "$id: $(($(open_questions "$f") - asked)) comment(s) from collaborators, for you"
    fi
  fi
  job=$(fm_get "$f" worker_job)
  if moved_here "$f" "$aj"; then
    local err
    if err=$( (cmd_followup "$f" --fresh --note "This task moved to $CREW_HOST; your earlier session is gone. Rebuild context from the task file and the branch.") 2>&1 >/dev/null ); then
      echo "$id: its worker and worktree aren't on this machine; a fresh worker picks it up"
    else
      warn "$id: couldn't start a fresh worker for it here: $err"
    fi
    return 0
  fi
  # The rest needs the worker free (see job_busy); a busy one is left for a later
  # tick. It does at most one thing, in this order: send an unsent review round, send
  # a restack, or mark the task as waiting on the user. Nothing goes out twice:
  # last_round_sent and restack_sent record what was sent.
  rounds=$(fm_get "$f" review_rounds); sent=$(fm_get "$f" last_round_sent)
  if job_busy "$aj" "$job"; then
    ((${rounds:-0} <= ${sent:-0})) || echo "$id: round $rounds waits for its worker ($(job_state "$aj" "$job"))"
    return 0
  fi
  if ((${rounds:-0} > ${sent:-0})); then
    if (cmd_followup "$f") >/dev/null; then echo "$id: round $rounds sent to its worker"; fi
    return 0
  fi
  reason=$(restack_reason "$f")
  if [[ $st == pr-open && -n $reason && $reason != *" abandoned" ]] && ! parent_needs_restack "$f"; then
    target=$(restack_target "$f")
    if [[ -n $target && $(fm_get "$f" restack_sent) != "$target" ]]; then
      if (cmd_restack "$f") >/dev/null; then echo "$id: restack sent to its worker ($reason)"; fi
      return 0
    fi
  fi
  waiting=$(open_questions "$f")
  if [[ $st != needs-input ]] && ((waiting > 0)); then
    if (cmd_set "$f" status needs-input) >/dev/null; then echo "$id: waiting on you ($waiting open question(s))"; fi
  fi
}

cmd_list() {
  local all=0 want="" p
  while (($#)); do case $1 in --all) all=1; shift ;; --status) want=$2; shift 2 ;; *) shift ;; esac; done
  local scope=""
  if ((all == 0)); then scope=$(project_from_cwd 2>/dev/null || true); fi
  local f st
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    st=$(fm_get "$f" status)
    [[ -z $want || $st == "$want" ]] || continue
    printf '%-14s %-34s %-20s %s\n' "$(fm_get "$f" project | cut -c1-14)" "$(basename "$f" .md | cut -c1-34)" "$st" "$(fm_get "$f" title)"
  done < <(files_of tasks "$scope")
}

cmd_get() { local f; f=$(resolve tasks "${1:?usage: crew get TASK KEY}"); fm_get "$f" "${2:?key required}"; }

cmd_set() {
  local f; f=$(resolve tasks "${1:?usage: crew set TASK KEY VALUE}")
  local key=${2:?key required}; shift 2
  lock
  fm_set "$f" "$key" "$*"; touch_updated "$f"
  [[ $key == status ]] && append_log "$f" "status → $*"
  commit "set $(basename "$f" .md) $key"
}

cmd_log() {
  local f; f=$(resolve tasks "${1:?usage: crew log TASK MESSAGE}"); shift
  [[ -n $* ]] || die "message required"
  lock
  append_log "$f" "$*"; touch_updated "$f"
  commit "log $(basename "$f" .md)"
}

cmd_cleanup() {
  need git
  local arg="" force=0 merged=0
  while (($#)); do case $1 in --force) force=1; shift ;; --merged) merged=1; shift ;; *) arg=$1; shift ;; esac; done
  local files=()
  if ((merged)); then
    local p f; p=$(current_project_or_die)
    while IFS= read -r f; do
      [[ -n $f && $(fm_get "$f" status) == merged && -n $(fm_get "$f" worktree) ]] && files+=("$f")
    done < <(files_of tasks "$p")
    ((${#files[@]})) || { echo "Nothing to clean up."; return; }
  else
    files=("$(resolve tasks "${arg:?usage: crew cleanup TASK|--merged [--force]}")")
  fi
  lock
  local file id st wt branch job
  for file in "${files[@]}"; do
    id=$(basename "$file" .md)
    load_project "$(task_project "$file")"
    st=$(fm_get "$file" status); wt=$(fm_get "$file" worktree); branch=$(fm_get "$file" branch); job=$(fm_get "$file" worker_job)
    if [[ $st != merged && $st != abandoned && $force == 0 ]]; then warn "$id is '$st'; skipping (use --force)"; continue; fi
    if [[ -n $wt && -d $wt && $force == 0 && -n $(git -C "$wt" status --porcelain 2>/dev/null) ]]; then
      warn "$id: $wt has uncommitted changes; skipping (use --force)"; continue
    fi
    # The worker goes first, so it doesn't carry on in a deleted directory, and the
    # worktree tool's remove hooks run without it or the processes it left behind.
    remove_worker "$job" || { warn "$id: worker $job is still running; skipping (stop it in claude agents)"; continue; }
    if [[ -n $wt && -d $wt ]]; then
      stop_processes_in "$wt"
      worktree_remove "$wt" "$force" "$CREW_HOME/logs/worktree-$PROJECT-$id.log" || { warn "$id: couldn't remove $wt"; continue; }
    fi
    if [[ $st == merged && -n $branch ]]; then git -C "$REPO" branch -D "$branch" >/dev/null 2>&1 || true; fi
    fm_set "$file" worktree ""; touch_updated "$file"
    append_log "$file" "cleaned up worktree${st:+ ($st)}"
    echo "cleaned up $id"
  done
  commit "cleanup"
}

cmd_commit() {
  # A hook must never fail the tool call, and lock can die (on another machine, say).
  if [[ ${1:-} == --hook ]]; then (commit_hook) || true; return 0; fi
  lock; commit "${*:-manual edits}"; echo "ledger committed"
}

# A PostToolUse hook, after an agent's Edit or Write: an edit to the ledger is
# committed (and so pushed) at once, as crew's own changes are. Any other file is
# left alone. It reads the hook JSON on stdin and never fails the tool call.
commit_hook() {
  local input path cwd home rel p
  input=$(cat)
  path=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input" 2>/dev/null) || return 0
  [[ -n $path ]] || return 0
  if [[ $path != /* ]]; then cwd=$(jq -r '.cwd // empty' <<<"$input"); path="${cwd:-$PWD}/$path"; fi
  path=$(realpath -m "$path"); home=$(realpath -m "$CREW_HOME")
  rel=${path#"$home"/}
  [[ $rel != "$path" ]] || return 0
  for p in "${STATE_PATHS[@]}"; do
    if [[ $rel == "$p"/* ]]; then lock; commit "edit $rel"; return 0; fi
  done
}

cmd_observe() {
  need claude
  local arg="" base="" dir="" p
  while (($#)); do case $1 in --base) base=$2; shift 2 ;; *) arg=$1; shift ;; esac; done
  if [[ -n $arg && -d $arg ]]; then dir=$(realpath "$arg")
  elif [[ -n $arg ]]; then
    local f; f=$(resolve tasks "$arg"); dir=$(fm_get "$f" worktree)
    [[ -n $dir ]] || die "task has no worktree"
    [[ -d $dir ]] || { echo "nothing to observe: $(basename "$f" .md)'s worktree isn't on this machine"; return 0; }
    if [[ -z $base ]]; then
      base="origin/$(fm_get "$f" base)"
      # A merged parent's branch may be gone from origin; base_sha still marks where this task's own commits start.
      if ! git -C "$dir" rev-parse --verify --quiet "$base^{commit}" >/dev/null && [[ -n $(fm_get "$f" base_sha) ]]; then
        base=$(fm_get "$f" base_sha)
      fi
    fi
  else dir=$(pwd)
  fi
  if [[ -z $base ]]; then
    if p=$(cd "$dir" && project_from_cwd 2>/dev/null); then load_project "$p"; base="origin/$DEFAULT_BRANCH"; else base="origin/HEAD"; fi
  fi
  (cd "$dir" && cc -p --agent casual-observer --permission-mode default --permission-prompts none \
     --settings "$CREW_HOME/config/readonly-settings.json" \
     "Review the change $base...HEAD in this repository.")
}

cmd_gardener() {
  need git; need claude
  require_host
  local projects=() p
  case ${1:-} in
    --all) mapfile -t projects < <(projects_in_scope all) ;;
    "") projects=("$(current_project_or_die)") ;;
    *) projects=("$1") ;;
  esac
  mkdir -p "$CREW_HOME/logs"
  local wt head last base count range prompt logf rc failures=0
  for p in "${projects[@]}"; do
    ( load_project "$p"
      wt="$WORK_ROOT/$p/_gardener"
      detached_checkout "$wt"
      head=$(git -C "$wt" rev-parse HEAD)
      last=$(cat "$PDIR/gardener.last" 2>/dev/null || true)
      if [[ $last == "$head" ]]; then echo "$p: nothing new since last run"; exit 0; fi
      if [[ -n $last ]] && git -C "$wt" merge-base --is-ancestor "$last" "$head" 2>/dev/null; then base=$last
      else base=$(git -C "$wt" rev-list -1 --before="$GARDENER_LOOKBACK" "$head" || true); fi
      if [[ -n $base ]]; then range="$base..$head"; count=$(git -C "$wt" rev-list --count "$range")
      else range="$head"; count=$(git -C "$wt" rev-list --count "$head"); fi
      if [[ $count == 0 ]]; then echo "$head" >"$PDIR/gardener.last"; echo "$p: no commits in range"; exit 0; fi
      prompt="Project: $p
Proposals directory: $PDIR/proposals
Tasks directory: $PDIR/tasks
Proposal template: $CREW_HOME/templates/proposal.md
Commit range to review: $range ($count commits on origin/$DEFAULT_BRANCH)
Today's date: $(date +%F)
Follow your process and write proposals only into the proposals directory."
      logf="$CREW_HOME/logs/gardener-$p-$(date +%Y%m%d-%H%M).log"
      echo "$p: reviewing $count commits ($range) — log: $logf"
      rc=0
      (cd "$wt" && cc -p --add-dir "$CREW_HOME" --agent gardener --permission-mode acceptEdits \
         --permission-prompts none --max-turns "$GARDENER_MAX_TURNS" \
         --settings "$CREW_HOME/config/readonly-settings.json" "$prompt") >"$logf" 2>&1 || rc=$?
      tail -n 15 "$logf"
      if ((rc == 0)); then
        echo "$head" >"$PDIR/gardener.last"
        lock; commit "gardener $p ($range)"
      else warn "$p: gardener exited with $rc; see $logf"; exit 1; fi
    ) || { warn "$p: gardener run failed"; failures=$((failures + 1)); }
  done
  ((failures == 0))
}

cmd_proposals() {
  local all=0; [[ ${1:-} == --all ]] && all=1
  local p; p=$(project_from_cwd 2>/dev/null || true)
  local f st n=0
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    st=$(fm_get "$f" status)
    [[ $all == 1 || $st == open ]] || continue
    printf '%-44s %-9s %-3s %s\n' "$(basename "$f" .md | cut -c1-44)" "$st" "$(fm_get "$f" size)" "$(fm_get "$f" title)"
    n=$((n + 1))
  done < <(files_of proposals "$p")
  ((n)) || { ((all)) && echo "No proposals." >&2 || echo "No open proposals." >&2; }
}

cmd_promote() {
  local pf; pf=$(resolve proposals "${1:?usage: crew promote PROPOSAL [--branch NAME]}"); shift
  local branchargs=()
  while (($#)); do
    case $1 in
      --branch) branchargs=(--branch "$2"); shift 2 ;;
      *) die "usage: crew promote PROPOSAL [--branch NAME]" ;;
    esac
  done
  local proj title taskfile tid tmp pst
  pst=$(fm_get "$pf" status)
  [[ $pst == open || $pst == deferred ]] || die "proposal is '$pst' (task: $(fm_get "$pf" task)); only open or deferred proposals can be promoted"
  proj=$(fm_get "$pf" project); title=$(fm_get "$pf" title)
  [[ -n $proj && -d $CREW_HOME/projects/$proj ]] || proj=$(basename "$(dirname "$(dirname "$pf")")")
  taskfile=$(cmd_new "$title" --project "$proj" "${branchargs[@]}" | tail -n1)
  tid=$(basename "$taskfile" .md)
  tmp=$(mktemp)
  {
    echo "From gardener proposal \`$(basename "$pf")\` ($pf). Run normal intake: confirm the plan with the user."
    echo
    section_body "$pf" "## Proposal"
    echo
    echo "First step suggested by the gardener:"
    section_body "$pf" "## First step"
  } >"$tmp"
  lock
  # Replace the Context placeholder with the proposal summary.
  local tmp2; tmp2=$(mktemp)
  CF="$tmp" awk 'BEGIN{cf=ENVIRON["CF"]} $0=="## Context"{print; while((getline l<cf)>0) print l; skip=1; next} skip&&/^## /{skip=0; print ""} !skip{print}' "$taskfile" >"$tmp2" && cat "$tmp2" >"$taskfile"
  rm -f "$tmp" "$tmp2"
  fm_set "$pf" status accepted; fm_set "$pf" task "$tid"; touch_updated "$pf"
  append_log "$pf" "promoted to task $tid"
  commit "promote $(basename "$pf" .md) → $tid"
  echo "$taskfile"
}

# ------------------------------------------------------------------- goals ---
# A goal is a batch of items the user hands the crew to work through without them.
# Its goal lead, a background session, writes and plan-reviews a brief for each item
# and marks it ready, answers its workers' questions, and parks what it shouldn't
# decide alone: a draft task with open questions for the user. crew tick dispatches
# the ready tasks and resumes the goal lead when there's input for it.

goal_tasks() {  # goal-file -> the files of the tasks that belong to the goal
  local id f
  id=$(basename "$1" .md)
  while IFS= read -r f; do
    if [[ -n $f && $(fm_get "$f" goal) == "$id" ]]; then echo "$f"; fi
  done < <(files_of tasks "$(fm_get "$1" project)")
}

goal_running() {  # task-file -> 0 if the task belongs to a running goal
  local g; g=$(fm_get "$1" goal)
  [[ -n $g && $(fm_get "$CREW_HOME/projects/$(fm_get "$1" project)/goals/$g.md" status 2>/dev/null) == running ]]
}

# Finished: the goal has tasks, and every one of them is merged or abandoned.
goal_finished() {  # goal-file
  local f n=0
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    has_word "$(fm_get "$f" status)" "merged abandoned" || return 1
    n=$((n + 1))
  done < <(goal_tasks "$1")
  ((n > 0))
}

# A worker's open questions: the unchecked items under Open questions, leaving out
# the collaborators' PR comments crew feedback records there ("@login …"), which
# are for the user.
worker_questions() {  # task-file
  section_body "$1" "## Open questions" | grep '^- \[ \]' | grep -v '^- \[ \] @' || true
}

# A dispatched goal task whose worker has questions the goal lead hasn't been sent.
# questions_routed is a checksum of the questions last sent, so one the goal lead
# left for the user isn't sent again, but a new one is.
unrouted_questions() {  # task-file -> prints the checksum to record once they're sent
  local q sum
  has_word "$(fm_get "$1" status)" "$ACTIVE_STATES" || return 1
  q=$(worker_questions "$1")
  [[ -n $q ]] || return 1
  sum=$(cksum <<<"$q"); sum=${sum%% *}
  [[ $sum != "$(fm_get "$1" questions_routed)" ]] || return 1
  echo "$sum"
}

# The goal lead reads the code in a detached checkout of origin/DEFAULT_BRANCH,
# which crew refreshes before each of its turns. Needs load_project.
goal_checkout() {  # goal-file
  echo "$WORK_ROOT/$PROJECT/_goal-$(basename "$1" .md)"
}

# A goal lead runs with the lead's settings, lead/.claude/settings.json, all but
# their "agent": the lead's session takes its agent from that file, a goal lead
# from --agent. Not the lead's settings.local.json: a goal lead works in its own
# checkout. A resume passes no launch flags (see launch_session), so only a fresh
# session needs the settings.
launch_goal_lead() {  # goal-file checkout prompt mode(fresh|resume) -> sets LAUNCH_JOB LAUNCH_SESSION
  local settings=""
  if [[ $4 == fresh ]]; then settings=$(jq -c 'del(.agent)' "$CREW_HOME/lead/.claude/settings.json"); fi
  launch_session "$1" lead "$2" "$3" "$4" --agent goal-lead --permission-mode "$LEAD_PERMISSION_MODE" \
    --settings "$settings"
}

cmd_goal_new() {
  local title="" proj=""
  while (($#)); do
    case $1 in
      --project) proj=$2; shift 2 ;;
      *) title="${title:+$title }$1"; shift ;;
    esac
  done
  [[ -n $title ]] || die 'usage: crew goal new "<title>" [--project P]'
  [[ -n $proj ]] || proj=$(current_project_or_die)
  load_project "$proj"
  lock
  mkdir -p "$PDIR/goals"
  local n s id file content
  n=$(next_number goals "$proj")
  s=$(slugify "$title"); s=${s:0:40}; s=${s%-}
  id=$(printf '%03d-%s' "$n" "${s:-goal-$n}")
  file="$PDIR/goals/$id.md"
  content=$(<"$CREW_HOME/templates/goal.md")
  content=${content//'{{ID}}'/$id}
  content=${content//'{{TITLE}}'/${title//\"/\'}}
  content=${content//'{{PROJECT}}'/$proj}
  content=${content//'{{NOW}}'/$(now)}
  printf '%s\n' "$content" >"$file"
  append_log "$file" "created"
  commit "new goal $proj/$id"
  echo "$file"
}

cmd_goal_start() {
  need git; need jq; need claude
  local file; file=$(resolve goals "${1:?usage: crew goal start GOAL}")
  local id st checkout name
  id=$(basename "$file" .md); st=$(fm_get "$file" status)
  load_project "$(fm_get "$file" project)"
  [[ $st == draft ]] || die "goal $id is '$st'; give a running goal input with 'crew goal note'"
  [[ -n $(section_body "$file" "## Goal") ]] || die "goal $id has no Goal yet: write the user's own words into its ## Goal section"
  checkout=$(goal_checkout "$file")
  detached_checkout "$checkout"
  name="crew-$PROJECT-goal-$id"; name=${name:0:80}
  lock
  fm_set "$file" checkout "$checkout"
  fm_set "$file" lead_name "$name"
  launch_goal_lead "$file" "$checkout" "You are the goal lead for goal $id in project $PROJECT.
Goal file: $file
Your working directory is a checkout of origin/$DEFAULT_BRANCH; read the code there.
Read the goal file completely, then follow your workflow for a new goal." fresh \
    || die "could not start the goal lead (see output above)"
  fm_set "$file" lead_job "$LAUNCH_JOB"
  fm_set "$file" lead_session "$LAUNCH_SESSION"
  fm_set "$file" status running
  touch_updated "$file"
  append_log "$file" "started: goal lead $LAUNCH_JOB (session ${LAUNCH_SESSION:-unknown}) in $checkout"
  commit "start goal $PROJECT/$id"
  echo "started goal $id → goal lead $LAUNCH_JOB ($name)"
  echo "  watch: claude attach $LAUNCH_JOB   |   claude agents"
}

# Records the user's words under the goal's Decisions and passes them to the goal
# lead, now if it's free, or through crew tick once it is. A note to a done goal
# reopens it, for work the user adds later ("pick up the new cards").
cmd_goal_note() {
  local file; file=$(resolve goals "${1:?usage: crew goal note GOAL TEXT}"); shift
  [[ -n $* ]] || die "usage: crew goal note GOAL TEXT"
  local id st n tmp
  id=$(basename "$file" .md); st=$(fm_get "$file" status)
  [[ $st != abandoned ]] || die "goal $id is abandoned"
  tmp=$(mktemp)
  printf -- '- %s — from the user: %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >"$tmp"
  lock
  append_to_section "$file" "## Decisions" "$tmp"
  rm -f "$tmp"
  if [[ $st == draft ]]; then
    touch_updated "$file"; append_log "$file" "note recorded"; commit "note goal $id"
    echo "recorded under Decisions; the goal lead reads it when the goal starts"
    return 0
  fi
  if [[ $st == "done" ]]; then fm_set "$file" status running; append_log "$file" "reopened by a note"; fi
  n=$(fm_get "$file" unsent_notes)
  fm_set "$file" unsent_notes $((${n:-0} + 1))
  touch_updated "$file"; append_log "$file" "note recorded"
  commit "note goal $id"
  unlock
  (cmd_goal_followup "$file") || echo "recorded under Decisions; crew tick passes it to the goal lead once it's free"
}

# Resumes the goal lead with what's waiting for it: the user's unsent notes, and
# questions its tasks' workers have asked. Returns 3 if there's nothing.
cmd_goal_followup() {
  need git; need jq; need claude
  local file; file=$(resolve goals "${1:?usage: crew goal followup GOAL}")
  local id st notes t sum input="" routed=()
  id=$(basename "$file" .md); st=$(fm_get "$file" status)
  load_project "$(fm_get "$file" project)"
  [[ $st == running ]] || die "goal $id is '$st', not running"
  notes=$(fm_get "$file" unsent_notes); notes=${notes:-0}
  ((notes == 0)) || input+=$'\n'"- $notes new note(s) from the user under Decisions in the goal file"
  while IFS= read -r t; do
    if [[ -n $t ]] && sum=$(unrouted_questions "$t"); then
      input+=$'\n'"- $(basename "$t" .md): its worker has asked something (task file: $t)"
      routed+=("$t" "$sum")
    fi
  done < <(goal_tasks "$file")
  [[ -n $input ]] || { echo "nothing new for goal $id"; return 3; }
  local aj job
  aj=$(agents_json); job=$(fm_get "$file" lead_job)
  if job_busy "$aj" "$job"; then
    die "goal lead $job is busy ($(job_state "$aj" "$job")); crew tick passes this on once it's free"
  fi
  local checkout i
  checkout=$(goal_checkout "$file")
  detached_checkout "$checkout"
  lock
  fm_set "$file" checkout "$checkout"
  relaunch launch_goal_lead lead "$file" "$checkout" "New input for goal $id (goal file: $file):$input
Follow your workflow for new input." "You are the goal lead for goal $id in project $PROJECT, which is already under way.
Goal file: $file
Your working directory is a checkout of origin/$DEFAULT_BRANCH; read the code there.
Read the goal file completely, and the files of the tasks under its Items, before acting." 0
  fm_set "$file" lead_job "$LAUNCH_JOB"
  [[ -n $LAUNCH_SESSION ]] && fm_set "$file" lead_session "$LAUNCH_SESSION"
  fm_set "$file" unsent_notes 0
  touch_updated "$file"
  append_log "$file" "followup ($LAUNCH_MODE): goal lead $LAUNCH_JOB"
  for ((i = 0; i < ${#routed[@]}; i += 2)); do
    fm_set "${routed[i]}" questions_routed "${routed[i + 1]}"
    append_log "${routed[i]}" "open questions sent to the goal lead"
  done
  commit "followup goal $PROJECT/$id"
  echo "goal $id: input sent to its goal lead ($LAUNCH_MODE)"
}

# Stops and removes the goal lead and its checkout. The goal's tasks stay as they are.
retire_goal() {  # goal-file status(done|abandoned)
  local file=$1 id checkout job
  id=$(basename "$file" .md); job=$(fm_get "$file" lead_job); checkout=$(fm_get "$file" checkout)
  remove_worker "$job" || die "goal lead $job is still running; stop it in claude agents, then try again"
  if [[ -n $checkout && -d $checkout ]]; then
    stop_processes_in "$checkout"
    git -C "$REPO" worktree remove --force "$checkout" || warn "couldn't remove $checkout"
  fi
  lock
  fm_set "$file" checkout ""
  fm_set "$file" status "$2"
  touch_updated "$file"
  append_log "$file" "status → $2; goal lead and its checkout removed"
  commit "$2 goal $PROJECT/$id"
  echo "goal $id: $2"
}

cmd_goal_done() {
  local file; file=$(resolve goals "${1:?usage: crew goal done GOAL}")
  local id; id=$(basename "$file" .md)
  load_project "$(fm_get "$file" project)"
  [[ $(fm_get "$file" status) == running ]] || die "goal $id is '$(fm_get "$file" status)', not running"
  goal_finished "$file" || die "goal $id has tasks that aren't merged or abandoned yet"
  retire_goal "$file" "done"
}

cmd_goal_abandon() {
  local file; file=$(resolve goals "${1:?usage: crew goal abandon GOAL}")
  load_project "$(fm_get "$file" project)"
  [[ $(fm_get "$file" status) != abandoned ]] || die "goal $(basename "$file" .md) is already abandoned"
  retire_goal "$file" abandoned
}

cmd_goal() {
  local sub=${1:-}
  shift || true
  case $sub in
    new) cmd_goal_new "$@" ;;
    start) cmd_goal_start "$@" ;;
    note) cmd_goal_note "$@" ;;
    followup) cmd_goal_followup "$@" ;;
    done) cmd_goal_done "$@" ;;
    abandon) cmd_goal_abandon "$@" ;;
    path) resolve goals "${1:?usage: crew goal path GOAL}" ;;
    *) die "usage: crew goal new|start|note|followup|done|abandon|path … (see 'crew help')" ;;
  esac
}

# ---------------------------------------------------------------- install ---
# crew install puts this machine's files in place: the agents in ~/.claude/agents/,
# the fish files in ~/.config/fish/, and the systemd units (installed, not enabled).
# Re-running it is safe. A file is replaced only when it differs, after a backup,
# and by rename, so a running crew-guard hook never reads half a file. A file an
# earlier install shipped and this one doesn't is backed up and removed. The
# manifest of what was shipped, and the backups, live in INSTALL_STATE.

INSTALL_STATE="$HOME/.local/share/agent-crew"
# One run's bookkeeping, set up by cmd_install and used by the helpers below.
INSTALL_BACKUP=""                       # this run's backup directory
INSTALL_TMP=""                          # where render puts its copies
INSTALL_OLD=()                          # the last run's manifest: "component<TAB>path" lines
INSTALL_NEW=()                          # this run's manifest lines so far
declare -A INSTALL_SHIPPED=()           # path -> 1 for every file this run shipped
declare -A INSTALL_PRUNED=()            # component -> 1 once prune has run for it

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }

# The version of crew's code in this home, which comes with each upgrade.
# Whether Claude Code trusts DIR. Trust accepted in a folder covers the folders
# below it, and inside a git repo Claude Code records it for the repo's top level
# (the home, for lead/), so a folder above DIR counts too.
trusted() {
  local folder=$1
  while :; do
    jq -e --arg p "$folder" '.projects[$p].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1 && return 0
    [[ $folder == / ]] && return 1
    folder=$(dirname "$folder")
  done
}

crew_version() { cat "$CREW_HOME/VERSION" 2>/dev/null || echo unknown; }

backup() {  # file -> a copy in this run's backup dir, at its path under $HOME
  local rel=${1#"$HOME"/}
  mkdir -p "$INSTALL_BACKUP/$(dirname "$rel")"; cp -p "$1" "$INSTALL_BACKUP/$rel"
  note "backed up ~/$rel → $INSTALL_BACKUP/"
}

put() {  # src dst — replace dst with src, backing up a dst that differs
  local src=$1 dst=$2 mode=644 tmp
  if [[ -x $src ]]; then mode=755; fi
  mkdir -p "$(dirname "$dst")"
  if [[ -f $dst ]] && cmp -s "$src" "$dst"; then chmod "$mode" "$dst"; return 0; fi
  if [[ -f $dst ]]; then backup "$dst"; fi
  tmp=$(mktemp "$dst.XXXXXX")
  cp "$src" "$tmp"; chmod "$mode" "$tmp"; mv -f "$tmp" "$dst"
}

install_file() {  # component src dst — put, and record it in the manifest
  put "$2" "$3"
  INSTALL_NEW+=("$1"$'\t'"$3"); INSTALL_SHIPPED[$3]=1
}

# Removes the files the last install of a component shipped and this one didn't.
# Run it after the component's install_file calls. It only touches files under
# root, the component's directory. A component this run skips (--no-fish,
# --no-systemd) is never pruned, so it loses nothing.
prune() {  # component root
  local comp=$1 root=$2 entry path
  # write_manifest replaces this component's old lines with the new ones.
  INSTALL_PRUNED[$comp]=1
  for entry in "${INSTALL_OLD[@]}"; do
    [[ ${entry%%$'\t'*} == "$comp" ]] || continue
    path=${entry#*$'\t'}
    [[ $path == "$root"/* && -f $path && -z ${INSTALL_SHIPPED[$path]:-} ]] || continue
    if [[ $comp == systemd ]]; then systemctl --user disable --now "$(basename "$path")" >/dev/null 2>&1 || true; fi
    backup "$path"; rm -f "$path"
    note "removed ${path/#"$HOME"/\~} (no longer shipped)"
  done
}

# The manifest has a "component<TAB>path" line for every file shipped: by this run,
# or by the last run of a component this one skipped.
write_manifest() {
  local entry
  mkdir -p "$INSTALL_STATE"
  {
    for entry in "${INSTALL_OLD[@]}"; do [[ -n ${INSTALL_PRUNED[${entry%%$'\t'*}]:-} ]] || printf '%s\n' "$entry"; done
    for entry in "${INSTALL_NEW[@]}"; do printf '%s\n' "$entry"; done
  } >"$INSTALL_STATE/manifest.tmp"
  mv -f "$INSTALL_STATE/manifest.tmp" "$INSTALL_STATE/manifest"
}

# A copy of src with this machine's crew home put in, so install_file compares
# what will actually be installed, and an unchanged re-run backs nothing up.
render() {  # src sed-script -> path of the copy
  local out; out="$INSTALL_TMP/$(basename "$1")"
  sed "$2" "$1" >"$out"; echo "$out"
}

settings_merge() {  # jq-filter [jq args...] — applied to ~/.claude/settings.json, after a backup
  local f="$HOME/.claude/settings.json" tmp
  mkdir -p "$HOME/.claude"; [[ -f $f ]] || echo '{}' >"$f"
  tmp=$(mktemp)
  if jq "$@" "$f" >"$tmp"; then
    if ! cmp -s "$tmp" "$f"; then backup "$f"; cat "$tmp" >"$f"; note "updated ~/.claude/settings.json"; fi
  else
    note "couldn't parse ~/.claude/settings.json; leaving it alone"
  fi
  rm -f "$tmp"
}

# The lead's settings for this machine, in the home but gitignored: it reads the
# ledger and the project checkouts as extra directories, and leaves out the home's
# CLAUDE.md, which is for developing crew. Rewritten only when it changes.
write_lead_local_settings() {
  local f="$CREW_HOME/lead/.claude/settings.local.json" tmp
  tmp=$(mktemp)
  jq -n --arg home "$CREW_HOME" --arg work "$WORK_ROOT" \
    '{permissions: {additionalDirectories: [$home, $work]}, claudeMdExcludes: [$home + "/CLAUDE.md"]}' >"$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 0; fi
  mkdir -p "$(dirname "$f")"; mv -f "$tmp" "$f"
  note "wrote ${f/#"$HOME"/\~}"
}

confirm() {  # question -> yes, unless the user answers no
  local a=""; read -r -p "  $1 [Y/n] " a || true
  [[ -z $a || $a == [Yy]* ]]
}

cmd_install() {
  local yes=0 fish=1 systemd=1 agents_md=ask
  while (($#)); do
    case $1 in
      --yes|-y) yes=1; shift ;;
      --no-fish) fish=0; shift ;;
      --no-systemd) systemd=0; shift ;;
      --skip-agents-md-setting) agents_md=skip; shift ;;
      *) die "usage: crew install [--yes] [--no-fish] [--no-systemd] [--skip-agents-md-setting]" ;;
    esac
  done
  local f rel c v missing=() custom=0
  INSTALL_BACKUP="$INSTALL_STATE/backups/$(date +%Y%m%d-%H%M%S)"
  INSTALL_TMP=$(mktemp -d)
  INSTALL_OLD=() INSTALL_NEW=() INSTALL_SHIPPED=() INSTALL_PRUNED=()
  if [[ -f $INSTALL_STATE/manifest ]]; then mapfile -t INSTALL_OLD <"$INSTALL_STATE/manifest"; fi
  # The fish and systemd files name ~/crew, the usual home. Only a home elsewhere
  # needs its path written into them (render).
  [[ $CREW_HOME == "$HOME/crew" ]] || custom=1

  say "Checking dependencies"
  for c in git gh jq flock claude fish; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
  if ((${#missing[@]})); then
    note "missing: ${missing[*]}"
    note "on CachyOS: sudo pacman -S --needed git github-cli jq util-linux fish"
    note "Claude Code: curl -fsSL https://claude.ai/install.sh | bash   (or 'claude update')"
  fi
  need jq
  if command -v claude >/dev/null 2>&1; then
    v=$(claude --version 2>/dev/null | awk '{print $1}')
    if [[ $(printf '%s\n' 2.1.281 "$v" | sort -V | head -1) != 2.1.281 ]]; then
      note "Claude Code $v is older than 2.1.281; run 'claude update' (AGENTS.md loading and agent view need it)"
    else note "Claude Code $v"; fi
  fi

  say "Installing agent profiles → ~/.claude/agents/"
  for f in "$CREW_HOME"/agents/*.md; do install_file agents "$f" "$HOME/.claude/agents/$(basename "$f")"; note "$(basename "$f" .md)"; done
  prune agents "$HOME/.claude/agents"

  # Hooks find crew-guard through CREW_HOME, and so do sessions that run crew.
  say "Crew home: $CREW_HOME"
  settings_merge '.env.CREW_HOME = $home' --arg home "$CREW_HOME"
  mkdir -p "$WORK_ROOT"
  write_lead_local_settings

  if ((fish)); then
    say "Installing fish integration → ~/.config/fish/"
    while IFS= read -r -d '' f; do
      rel=${f#"$CREW_HOME/fish/"}
      if [[ $rel == conf.d/agent-crew.fish ]] && ((custom)); then
        f=$(render "$f" "s#^set -q CREW_HOME; or set -gx CREW_HOME .*#set -q CREW_HOME; or set -gx CREW_HOME $CREW_HOME#")
      fi
      install_file fish "$f" "$HOME/.config/fish/$rel"
    done < <(find "$CREW_HOME/fish" -type f -print0 | sort -z)
    prune fish "$HOME/.config/fish"
    note "open a new fish shell (or: source ~/.config/fish/conf.d/agent-crew.fish)"
  fi

  if ((systemd)); then
    say "Installing the crew's systemd units → ~/.config/systemd/user/"
    for f in "$CREW_HOME"/systemd/*; do
      if [[ $f == *.service ]] && ((custom)); then
        f=$(render "$f" "s#%h/crew#$CREW_HOME#g; s|^# Environment=CREW_HOME=.*|Environment=CREW_HOME=$CREW_HOME|")
      fi
      install_file systemd "$f" "$HOME/.config/systemd/user/$(basename "$f")"
    done
    prune systemd "$HOME/.config/systemd/user"
    systemctl --user daemon-reload 2>/dev/null || true
    local unit off=()
    for unit in "${CREW_UNITS[@]}"; do
      systemctl --user is-enabled --quiet "$unit" 2>/dev/null || off+=("$unit")
    done
    ((${#off[@]} == 0)) || note "off on this machine: ${off[*]}. crew host up turns them on, to run the crew here"
  fi

  write_manifest

  # Asked once: not when the setting is on already, or when the user declined before.
  if [[ $agents_md == ask && ! -f $INSTALL_STATE/agents-md-declined ]] \
     && ! jq -e '.pluginConfigs["agents-md@builtin"].options.instructionFiles == "claude-md-and-agents-md"' \
            "$HOME/.claude/settings.json" >/dev/null 2>&1; then
    say "AGENTS.md loading"
    note "Claude Code reads AGENTS.md automatically, but only when a repo has no CLAUDE.md."
    if ((yes)) || confirm "In repos that have both, load CLAUDE.md and AGENTS.md together?"; then
      settings_merge '.pluginConfigs["agents-md@builtin"].options.instructionFiles = "claude-md-and-agents-md"'
    else
      mkdir -p "$INSTALL_STATE"; touch "$INSTALL_STATE/agents-md-declined"
      note "skipped, and won't ask again; see SETUP.md if you change your mind"
    fi
  fi
  rm -rf "$INSTALL_TMP"

  say "Done (crew $(crew_version))"
}

# The lead's reading copy of a project: a detached checkout of a freshly fetched
# origin/DEFAULT_BRANCH, beside the task worktrees. Prints its path.
cmd_checkout() {
  [[ $# == 1 ]] || die "usage: crew checkout PROJECT"
  load_project "$1"
  local co="$WORK_ROOT/$PROJECT/_lead"
  detached_checkout "$co"
  echo "$co"
}

cmd_project() {
  local sub=${1:-}
  shift || true
  case $sub in
    add) cmd_project_add "$@" ;;
    *) die "usage: crew project add [PATH]" ;;
  esac
}

cmd_doctor() {
  local ok=1 v
  chk() { if eval "$2" >/dev/null 2>&1; then printf '  ok   %s\n' "$1"; else printf '  FAIL %s%s\n' "$1" "${3:+ — $3}"; ok=0; fi; }
  echo "crew $(crew_version) at $CREW_HOME"
  echo "Dependencies"
  local deps=(git gh jq flock claude) c
  for c in "${deps[@]}"; do chk "$c installed" "command -v $c"; done
  if command -v claude >/dev/null; then
    v=$(claude --version 2>/dev/null | awk '{print $1}')
    chk "claude $v >= 2.1.281" "[[ \$(printf '%s\n' 2.1.281 '$v' | sort -V | head -1) == 2.1.281 ]]" "run 'claude update'"
  fi
  chk "gh authenticated" "gh auth status" "run 'gh auth login'"
  echo "Agents"
  for c in lead implementer casual-observer plan-reviewer gardener goal-lead; do chk "$c" "[[ -f \$HOME/.claude/agents/$c.md ]]" "run crew install"; done
  echo "Crew home"
  chk "$CREW_HOME is a git repo" "git -C '$CREW_HOME' rev-parse"
  chk "crew-guard executable" "[[ -x '$CREW_HOME/bin/crew-guard' ]]"
  # The settings hook is what guards the subagents a lead or worker spawns. An edited
  # settings file keeps its old contents on re-install, so it can be missing.
  guard_hooked() {  # settings-file role
    chk "$1 runs crew-guard" "jq -e '[.hooks.PreToolUse[]?.hooks[]?.command] | any(endswith(\"crew-guard\\\" $2\"))' '$CREW_HOME/$1'" \
        "restore its hook: git -C $CREW_HOME diff $1"
  }
  guard_hooked lead/.claude/settings.json lead
  guard_hooked config/worker-settings.json worker
  # Without it, an agent's own edits to the ledger wait for crew's next commit.
  for c in lead/.claude/settings.json config/worker-settings.json; do
    chk "$c commits ledger edits (crew commit --hook)" \
        "jq -e '[.hooks.PostToolUse[]?.hooks[]?.command] | any(endswith(\"bin/crew\\\" commit --hook\"))' '$CREW_HOME/$c'" \
        "restore its hook: git -C $CREW_HOME diff $c"
  done
  chk "lead/.claude/settings.local.json written for this machine" "[[ -f '$CREW_HOME/lead/.claude/settings.local.json' ]]" "run crew install"
  local pd p tool
  for pd in "$CREW_HOME"/projects/*/; do
    [[ -f $pd/project.env ]] || continue
    p=$(basename "$pd")
    # shellcheck source=/dev/null
    tool=$(. "$pd/project.env" && echo "${WORKTREE_TOOL:-git}")
    case $tool in
      git) ;;
      worktrunk) chk "$p: wt installed (WORKTREE_TOOL=worktrunk)" "command -v wt" "install Worktrunk: https://worktrunk.dev" ;;
      *) chk "$p: WORKTREE_TOOL is git or worktrunk (got '$tool')" false "fix $pd/project.env" ;;
    esac
    chk "$p: cloned on this machine (local.env)" "(. '$pd/local.env' && [[ -d \$REPO ]])" "run 'crew project add' in your clone of it"
    [[ -f $pd/worker-settings.json ]] && chk "$p: worker-settings.json is valid JSON" "jq -e . '$pd/worker-settings.json'" "fix it; dispatch refuses to start workers until then"
  done
  echo "Trust (workers start in worktrees under WORK_ROOT; the lead in the home's lead/)"
  for c in "$WORK_ROOT" "$CREW_HOME/lead"; do
    chk "$c trusted" "trusted '$c'" "cd $c && claude, accept, /exit"
  done
  # A unit runs crew with the PATH its service sets, not your shell's, so a tool
  # your shell finds through its config (mise, nvm, ...) can be missing there.
  echo "Enabled units"
  local unit svc path
  for unit in "${CREW_UNITS[@]}"; do
    systemctl --user is-enabled --quiet "$unit" 2>/dev/null || continue
    svc=${unit%.*}.service   # crew-tick.timer starts crew-tick.service
    path=$(systemctl --user show "$svc" -p Environment --value 2>/dev/null | tr " " "\n" | sed -n "s/^PATH=//p")
    for c in "${deps[@]}"; do
      chk "$svc finds $c" "(PATH='$path'; command -v $c)" "add its directory to PATH: systemctl --user edit $svc"
    done
  done
  echo "AGENTS.md loading"
  local req_ok=$ok
  chk "Project instructions = claude-md-and-agents-md (optional)" \
      "jq -e '.pluginConfigs[\"agents-md@builtin\"].options.instructionFiles == \"claude-md-and-agents-md\"' \$HOME/.claude/settings.json" \
      "only matters for repos that have both CLAUDE.md and AGENTS.md"
  if ((req_ok)); then echo "Required checks passed."; else echo "Some required checks failed."; return 1; fi
}

# ------------------------------------------------------------------- main ---

cmd=${1:-help}; shift || true
case $cmd in
  help|-h|--help) cmd_help ;;
  project) cmd_project "$@" ;;
  checkout) cmd_checkout "$@" ;;
  host) cmd_host "$@" ;;
  serve) cmd_serve "$@" ;;
  setup) cmd_setup "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  migrate-ledger) cmd_migrate_ledger "$@" ;;
  config) cmd_config "$@" ;;
  doctor) cmd_doctor ;;
  install) cmd_install "$@" ;;
  new) cmd_new "$@" ;;
  ready) cmd_ready "$@" ;;
  dispatch) cmd_dispatch "$@" ;;
  feedback) cmd_feedback "$@" ;;
  followup) cmd_followup "$@" ;;
  restack) cmd_restack "$@" ;;
  reply) cmd_reply "$@" ;;
  status) cmd_status "$@" ;;
  sync) cmd_sync "$@" ;;
  tick) cmd_tick "$@" ;;
  list|ls) cmd_list "$@" ;;
  show) f=$(resolve tasks "${1:?usage: crew show TASK}") && cat "$f" ;;
  path) resolve tasks "${1:?usage: crew path TASK}" ;;
  find) f=$(resolve tasks "${1:?usage: crew find TASK}") && basename "$f" .md ;;
  get) cmd_get "$@" ;;
  set) cmd_set "$@" ;;
  log) cmd_log "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  commit) cmd_commit "$@" ;;
  observe) cmd_observe "$@" ;;
  gardener) cmd_gardener "$@" ;;
  proposals) cmd_proposals "$@" ;;
  promote) cmd_promote "$@" ;;
  goal) cmd_goal "$@" ;;
  *) die "unknown command '$cmd' (see 'crew help')" ;;
esac
