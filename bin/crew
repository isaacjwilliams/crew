#!/bin/sh
# crew's launcher: runs the binary for this home's VERSION (or $CREW_VERSION) from
# bin/release/, after downloading it from that version's GitHub release the first
# time. A fork that publishes its own releases changes the URL below.
releases=https://github.com/isaacjwilliams/crew/releases/download
code=1; [ "${1-}" = guard ] && code=2   # a guard that can't run must block the edit
fail() { echo "crew: $*" >&2; exit "$code"; }
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
bin=$(cd "$(dirname "$self")" && pwd -P) || fail "can't find the crew home of $0"
home=$(dirname "$bin")
version=${CREW_VERSION:-$(cat "$home/VERSION" 2>/dev/null)}
[ -n "$version" ] || fail "no VERSION in $home"
exe=$bin/release/crew-$version
if [ ! -x "$exe" ]; then
  url=$releases/v$version/crew-$(uname -s)-$(uname -m)
  tmp=$exe.download.$$
  # Checked by running it before it's put in place, so a bad download is never run again.
  { mkdir -p "$bin/release" && curl -fsSL -o "$tmp" "$url" && chmod +x "$tmp" &&
    [ "$("$tmp" version 2>/dev/null)" = "$version" ] && mv -f "$tmp" "$exe"; } ||
    { rm -f "$tmp"; fail "couldn't download crew $version from $url"; }
fi
CREW_HOME=${CREW_HOME:-$home} && export CREW_HOME
exec "$exe" "$@"
