# Your crew settings. Anything set here overrides config/defaults.env, which
# lists every setting with its default and what it does. Per-project overrides
# go in projects/<project>/project.env.

# Prefix for the branches workers push to the shared remote, so your
# collaborators can tell them apart, e.g. "isaac/".
BRANCH_PREFIX="agent/"

# How many workers may run, and how many tasks may be in flight, at once.
# MAX_WORKERS=3
# MAX_IN_FLIGHT=5
